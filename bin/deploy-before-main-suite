#!/usr/bin/env bash
# Exits as the gate does: 0 early, 1 wait for the suite, 2 could not decide.
set -euo pipefail

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
runs_api="repos/${GITHUB_REPOSITORY}/actions/workflows/tests.yml/runs?branch=main&event=push&per_page=100"

# The runs API goes stale for a branch filter alone and for created windows
# past about two weeks, so the 30 days GitHub allows re-runs for are read in
# 7-day slices; the older slices keep only re-runs, which keep their old
# created_at. Any failed request stops the decision: a missing run could hide a
# retry.
day() { date -u -d "$1 days ago" +%Y-%m-%dT%H:%M:%SZ; }
gh api --paginate "${runs_api}&created=>=$(day 7)" --jq '.workflow_runs' > "$dir/runs-recent.json" || exit 2
for slice in "7 14" "14 21" "21 28" "28 31"; do
  read -r newer older <<< "$slice"
  gh api --paginate "${runs_api}&created=$(day "$older")..$(day "$newer")" \
    --jq '[.workflow_runs[] | select(.run_attempt > 1)]' > "$dir/runs-older-${newer}.json" || exit 2
done
# A current list holds this commit's own Tests run, created at the push. Without
# it the list is stale, and a red run in it could be missing.
if ! jq -se --arg sha "$COMMIT_SHA" 'add | any(.head_sha == $sha)' "$dir/runs-recent.json" >/dev/null; then
  echo "The recent Tests runs do not include ${COMMIT_SHA}; the list is stale."
  exit 2
fi
for status in in_progress queued waiting requested pending; do
  gh api --paginate "${runs_api}&status=${status}" --jq '.workflow_runs' > "$dir/runs-${status}.json" || exit 2
done
# A run can finish between the queries above; read each unfinished one again
# last, so its newest state is the one the gate keeps.
jq -s 'add' "$dir"/runs-*.json > "$dir/runs-listed.json" || exit 2
for id in $(jq -r '[.[] | select(.status != "completed") | .id] | unique | .[]' "$dir/runs-listed.json"); do
  gh api "repos/${GITHUB_REPOSITORY}/actions/runs/${id}" --jq '[.]' > "$dir/runs-fresh-${id}.json" || exit 2
done
jq -s 'add' "$dir"/runs-*.json > "$dir/runs.json" || exit 2

# GitHub can link a fresh merge commit to its PR a few seconds late.
head=""
for _ in 1 2 3 4 5 6; do
  gh api "repos/${GITHUB_REPOSITORY}/commits/${COMMIT_SHA}/pulls" > "$dir/pulls.json" || exit 2
  head=$(jq -r --arg sha "$COMMIT_SHA" '[.[] | select(.merged_at != null and .merge_commit_sha == $sha)] | first | .head.sha // empty' "$dir/pulls.json")
  [ -n "$head" ] && break
  sleep 10
done

ci_green=""
if [ -n "$head" ]; then
  ci_green=$(gh api "repos/${GITHUB_REPOSITORY}/commits/${head}/status" \
    --jq '[.statuses[] | select(.context == "ci/green")] | first | .state // empty') || exit 2
fi

jq -n --arg sha "$COMMIT_SHA" --arg ci_green "$ci_green" \
  --slurpfile runs "$dir/runs.json" --slurpfile pulls "$dir/pulls.json" \
  '{sha: $sha, runs: $runs[0], pulls: $pulls[0], ci_green: $ci_green}' > "$dir/gate.json"

set +e
line=$(ruby "$(dirname "$0")/deploy-before-main-suite-gate" "$dir/gate.json")
status=$?
set -e
echo "$line"
[ -n "${GITHUB_STEP_SUMMARY:-}" ] && echo "$line" >> "$GITHUB_STEP_SUMMARY"
exit "$status"
