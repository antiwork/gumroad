#!/usr/bin/env ruby
# frozen_string_literal: true

# Fails when a branch's migration versions cannot coexist with the base branch's.
#
# Two PRs that each add db/migrate/<V>_*.rb for the same V do not conflict in
# git -- different filenames, no shared lines -- so nothing blocks either merge
# and each PR's own CI is green. The second merge breaks main for everyone at
# `rake db:prepare`. See PR #6716.
#
# Reads filenames only, never file contents, so it is safe to run against an
# untrusted fork head.
#
#   bin/check-migration-versions [BASE_REF] [HEAD_REF]
#
# Refs default to origin/main and HEAD.
#
# Exit codes are a contract, because callers gate a required status on them:
# 0 clean, 1 a finding, 2 the check could not run (bad ref, git failure). Only
# 1 means "this branch collides" -- anything else must not be reported as one,
# or a transient git failure blocks every clean PR.

BASE_REF = ARGV[0] || "origin/main"
HEAD_REF = ARGV[1] || "HEAD"

EXIT_FINDING = 1
EXIT_OPERATIONAL = 2

# Distinct from a finding: the check itself could not complete.
class OperationalError < StandardError; end

# Rails' own MigrationFilenameRegexp (activerecord migration.rb). Anything
# looser and we accept a filename Rails rejects; anything stricter and we go
# blind to one it accepts -- engine-installed migrations carry a dotted infix
# (`..._add_service_name_to_active_storage_blobs.active_storage.rb`), and
# versions are not required to be 14 digits.
MIGRATION_FILENAME = /\A([0-9]+)_([_a-z0-9]*)\.?([_a-z0-9]*)?\.rb\z/

def git(*args)
  out = IO.popen(["git", *args], err: File::NULL, &:read)
  raise OperationalError, "git #{args.join(' ')} failed" unless $?.success?
  out
end

# version (Integer) => filenames, for every migration in db/migrate at `ref`.
def migrations_at(ref)
  git("ls-tree", "--name-only", "#{ref}:db/migrate").lines(chomp: true).each_with_object({}) do |name, acc|
    next unless (m = MIGRATION_FILENAME.match(name))
    (acc[m[1].to_i] ||= []) << name
  end
end

# The version schema.rb claims to be at. Everything at or below it is treated as
# already applied when a fresh database loads the schema.
#
# A failure here means the file is absent at that ref, not that the ref is bad:
# migrations_at has already resolved both refs by the time this runs. Absent
# schema.rb is a repo state to tolerate (rules 3 and 4 just do not apply), so it
# returns nil rather than raising operational.
def schema_version_at(ref)
  git("show", "#{ref}:db/schema.rb")[/define\(version:\s*([\d_]+)\)/, 1]&.delete("_")&.to_i
rescue OperationalError
  nil
end

# Rails writes schema.rb versions as YYYY_MM_DD_HHMMSS.
def schema_literal(version)
  s = version.to_s
  return s unless s.length == 14
  [s[0, 4], s[4, 2], s[6, 2], s[8, 6]].join("_")
end

begin
  base = migrations_at(BASE_REF)
  head = migrations_at(HEAD_REF)
rescue OperationalError => e
  warn "Migration version check could not run: #{e.message}"
  exit EXIT_OPERATIONAL
end
failures = []

# 1. Two files claiming one version. This is the abort itself: Rails collects
#    every version below schema.rb's and raises on any it sees twice, so
#    `db:prepare` dies before a single test runs.
head.each do |version, names|
  next if names.size < 2
  failures << <<~MSG
    Duplicate migration version #{version}
      #{names.sort.join("\n  ")}
    Rails aborts `rake db:prepare` on this: "Duplicate migration #{version}.
    Please renumber your migrations to resolve the conflict."
  MSG
end

# 2. A version the base branch already spent on a different migration. This is
#    the cross-PR collision, and it only becomes visible once the other PR
#    merges -- which is why this check re-runs against main on every push.
head.each do |version, names|
  base_names = base[version]
  next if base_names.nil?
  next if (names - base_names).empty?
  failures << <<~MSG
    Version #{version} is already used on #{BASE_REF} by a different migration
      #{BASE_REF}: #{base_names.sort.join(', ')}
      #{HEAD_REF}: #{names.sort.join(', ')}
    Renumber to a version above #{BASE_REF}'s newest (#{base.keys.max}). If your
    branch simply predates a rename of that migration on #{BASE_REF}, rebase
    instead -- renumbering a migration you do not own is the wrong fix.
  MSG
end

# 3. A new migration numbered at or below the base schema version. It does not
#    collide today, but a fresh database loads schema.rb and marks every version
#    at or below that line as applied, so this migration would silently never
#    run there while running normally on existing databases.
base_schema_version = schema_version_at(BASE_REF)
if base_schema_version
  buried = (head.keys - base.keys).select { |version| version <= base_schema_version }
  unless buried.empty?
    failures << <<~MSG
      New migration(s) numbered at or below #{BASE_REF}'s schema.rb version (#{base_schema_version}):
        #{buried.sort.flat_map { |v| head[v] }.join("\n  ")}
      A fresh database loading schema.rb records these as applied, so they would
      never run there. Renumber above #{base_schema_version}.
    MSG
  end
end

# 4. schema.rb must name the newest migration, or a database built from it is
#    missing whatever the migrations past that line create. This is also what
#    turns the `define(version:` line into a git conflict against main, so a
#    stale branch cannot merge a migration numbered under main's schema.
head_schema_version = schema_version_at(HEAD_REF)
newest = head.keys.max
if head_schema_version && newest && head_schema_version != newest
  failures << <<~MSG
    db/schema.rb is at version #{head_schema_version}, but the newest migration is #{newest}
      #{head[newest].join("\n  ")}
    Set `define(version: #{schema_literal(newest)})`.
  MSG
end

if failures.empty?
  puts "Migration versions OK: #{head.size} migrations, newest #{newest}, no collision with #{BASE_REF}."
  exit 0
end

warn "Migration version check failed (#{HEAD_REF} against #{BASE_REF}):\n\n"
failures.each { |f| warn "#{f}\n" }
exit EXIT_FINDING
