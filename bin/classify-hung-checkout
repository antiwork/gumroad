#!/usr/bin/env ruby
# frozen_string_literal: true

# Decides whether a `Tests` attempt went red *only* on infrastructure -- a hang
# that never let the specs run, or a job that burned its own budget. That is the
# one failure mode where re-running unattended tells us something new. A spec
# failure re-run tells us nothing and hides a real red, so anything that reached
# a non-hang failure blocks the whole verdict, not just its own job.
#
# Reads the attempt's jobs payload on stdin, or from a file argument:
#
#   { "jobs": [ ... GET /repos/{repo}/actions/runs/{id}/attempts/{n}/jobs ... ],
#     "annotations": { "<job_id>": ["<check-run annotation message>", ...] },
#     "conclusion": "<the triggering run's own conclusion>" }
#
# `--candidates` prints the job ids whose first bad step already looks like the
# hang, or that burned a plausible share of their own budget, so the caller only
# fetches annotations for that short list before asking for the verdict. No
# network in here: the file the workflow runs is the file the test runs.
#
# Exit codes are a contract -- 0 rerun, 1 skip, 2 could not run (bad input) --
# because the caller turns 0 into a real re-run and must treat everything else as
# "leave it alone".

require "json"
require "time"

EXIT_SKIP = 1
EXIT_OPERATIONAL = 2

# Steps whose timeout says nothing about the commit, each with the time a
# timed-out run of it takes and the annotation that proves the timeout. The
# window admits clock resolution, not a step that failed for another reason and
# happened to be slow.
#
# `Check out fork fixtures` is deliberately absent: it also has the checkout
# timeout, but it pulls untrusted fork refs and is not a step we re-run on a
# guess.
HANGS = {
  # The observed checkout hangs sat at exactly 300.0s.
  "Check out repository" => [270.0..330.0, "The action 'Check out repository' has timed out after 5 minutes"],
  "Check out trusted workflow files" => [270.0..330.0, "The action 'Check out trusted workflow files' has timed out after 5 minutes"],
  # nick-fields/retry: three 5-minute attempts, 5 seconds apart. The observed
  # Docker Hub pull timeouts took 916s.
  "Start services and pull test image" => [880.0..960.0, "Final attempt failed. Timeout of 300000ms hit"]
}.freeze
HANG_STEPS = HANGS.keys.freeze

# A job that burned its own `timeout-minutes` budget is cancelled by GitHub with
# this annotation, and that cancellation is what turns the whole run's conclusion
# into `cancelled` -- which neither this workflow's gate nor ci-green.yml acts on,
# so the PR's required `ci/green` never lands and auto-merge waits forever.
JOB_TIMEOUT_MESSAGE = "has exceeded the maximum execution time of"

# Cheap prefilter for the ids whose annotations are worth fetching: a job that
# burned a real budget was cancelled deep into it, so a short cancellation is
# never a timeout. Measured on the job's own wall clock, the budget GitHub
# cancels against -- the step the cancel landed in is only the remainder.
JOB_TIMEOUT_MIN_SECONDS = 600.0

# `timed_out` is a failure, not a cancellation: a job that ran out of its own
# budget is a red we must not paper over.
FAILED = %w[failure timed_out].freeze
BAD = (FAILED + %w[cancelled]).freeze
JOB_FAILED = %w[failure timed_out startup_failure cancelled].freeze

def steps_of(job)
  Array(job["steps"]).sort_by { |step| step["number"] || 0 }
end

def first_bad_step(job)
  steps_of(job).find { |step| BAD.include?(step["conclusion"]) }
end

def first_failed_step(job)
  steps_of(job).find { |step| FAILED.include?(step["conclusion"]) }
end

def step_seconds(step)
  started = step["started_at"]
  completed = step["completed_at"]
  return nil if started.nil? || completed.nil?
  Time.iso8601(completed) - Time.iso8601(started)
rescue ArgumentError
  nil
end

def job_seconds(job)
  started = job["started_at"]
  completed = job["completed_at"]
  return nil if started.nil? || completed.nil?
  Time.iso8601(completed) - Time.iso8601(started)
rescue ArgumentError
  nil
end

# Jobs with no `Run tests` step at all (Build images, Compute relevant specs)
# satisfy this too -- what matters is that no specs got the chance to run, so a
# re-run cannot be laundering a spec failure.
def run_tests_started?(job)
  steps_of(job).any? do |step|
    next false unless step["name"] == "Run tests"
    step["status"] == "in_progress" || BAD.include?(step["conclusion"]) || step["conclusion"] == "success"
  end
end

def candidate?(job)
  step = first_bad_step(job)
  return false unless step && HANG_STEPS.include?(step["name"])
  seconds = step_seconds(step)
  !seconds.nil? && HANGS.fetch(step["name"]).first.cover?(seconds)
end

# A job cancelled deep into its own budget. Only the annotation can confirm it,
# and annotations are fetched only for the ids `--candidates` names, so this
# names the id and `job_timed_out?` decides. The step is the fallback for a
# payload without job timestamps.
def job_timeout_candidate?(job)
  return false unless job["conclusion"] == "cancelled"
  step = first_bad_step(job)
  return false unless step && step["conclusion"] == "cancelled"
  burned = [job_seconds(job), step_seconds(step)].compact.max
  !burned.nil? && burned >= JOB_TIMEOUT_MIN_SECONDS
end

def job_timed_out?(job, annotations)
  Array(annotations[job["id"].to_s]).any? { |message| message.to_s.include?(JOB_TIMEOUT_MESSAGE) }
end

def hung?(job, annotations)
  return false if run_tests_started?(job)

  # The step-name classes first, each proved by its own annotation: a job that
  # happens to carry both must keep the verdict its step already earned.
  if candidate?(job)
    wanted = HANGS.fetch(first_bad_step(job)["name"]).last
    return true if Array(annotations[job["id"].to_s]).any? { |message| message.to_s.include?(wanted) }
  end

  # A job timeout is a cancellation, not a failure, so the annotation is what
  # separates it from a sibling a fail-fast or a cancel-in-progress threw away.
  job_timed_out?(job, annotations) && job_timeout_candidate?(job)
end

def job_label(job)
  job["name"] || "job #{job['id']}"
end

def verdict(jobs, annotations, conclusion = nil)
  # `failure` is admitted because fail-fast behind a hang still leaves the run
  # `failure`; `cancelled` only for the job-timeout shape, enforced by the
  # annotation check after `hangs`.
  if !conclusion.nil? && conclusion != "" && !%w[failure cancelled].include?(conclusion)
    return [EXIT_SKIP, "skip: the attempt concluded #{conclusion}"]
  end

  # A run that was cancelled before anything was scheduled has nothing to
  # attribute the failure to, so there is nothing to re-run.
  return [EXIT_SKIP, "skip: the attempt has no jobs"] if jobs.empty?

  jobs.each do |job|
    step = first_failed_step(job)
    next if step.nil? || HANG_STEPS.include?(step["name"])
    return [EXIT_SKIP, "skip: #{job_label(job)} failed at #{step['name'].inspect}"]
  end

  failing = jobs.select { |job| JOB_FAILED.include?(job["conclusion"]) }
  hangs = failing.select { |job| hung?(job, annotations) }
  return [EXIT_SKIP, "skip: no checkout, image-pull or job timeout on this attempt"] if hangs.empty?

  # A cancelled attempt is only re-runnable on evidence GitHub itself produced:
  # the job-timeout annotation. A manual cancel and a cancel-in-progress leave no
  # such annotation, so a run that was thrown away stays thrown away.
  if conclusion == "cancelled" && hangs.none? { |job| job_timed_out?(job, annotations) }
    return [EXIT_SKIP, "skip: the attempt was cancelled, not timed out"]
  end

  # Everything else that went red has to be collateral: fail-fast cancelling a
  # sibling mid-`Run tests` is not evidence of anything. A job that reached
  # `failure` on its own is, whatever its steps say.
  collateral = failing - hangs
  offender = collateral.find { |job| job["conclusion"] != "cancelled" }
  return [EXIT_SKIP, "skip: #{job_label(offender)} concluded #{offender['conclusion']}"] if offender

  # A sibling that burned its own budget inside `Run tests` timed out on the
  # specs, not on the setup in front of them. Re-running the attempt whole would
  # re-execute them, which is the one thing a spec timeout must never get.
  specs_timeout = collateral.find { |job| run_tests_started?(job) && job_timed_out?(job, annotations) }
  return [EXIT_SKIP, "skip: #{job_label(specs_timeout)} timed out inside Run tests"] if specs_timeout

  [0, "rerun: timed out on #{hangs.map { |job| "#{job_label(job)} (#{first_bad_step(job)['name']})" }.join(', ')}"]
end

raw = ARGV.reject { |arg| arg.start_with?("--") }.first
candidates_only = ARGV.include?("--candidates")

begin
  payload = JSON.parse(raw ? File.read(raw) : $stdin.read)
rescue JSON::ParserError, Errno::ENOENT => e
  warn "Hung-checkout classifier could not run: #{e.message}"
  exit EXIT_OPERATIONAL
end

jobs = Array(payload.is_a?(Hash) ? payload["jobs"] : payload)

if candidates_only
  jobs.each { |job| puts job["id"] if candidate?(job) || job_timeout_candidate?(job) }
  exit 0
end

code, message = verdict(
  jobs,
  payload.is_a?(Hash) ? payload["annotations"].to_h : {},
  payload.is_a?(Hash) ? payload["conclusion"] : nil
)
puts message
exit code
