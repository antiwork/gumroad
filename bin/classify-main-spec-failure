#!/usr/bin/env ruby
# frozen_string_literal: true

# Decides whether a failed `Tests` attempt on a `main` push gets one re-run of
# its failed jobs. Reads the attempt on stdin, or from a file argument:
#
#   { "jobs": [ ... GET /repos/{repo}/actions/runs/{id}/attempts/{n}/jobs ... ],
#     "conclusion": "<the triggering run's own conclusion>",
#     "event": "push", "head_branch": "main",
#     "summaries": { "<job_id>": "<the shard log's last RSpec summary line>" },
#     "declines": { "<job_id>": <true when the shard log says "Your card was declined."> },
#     "chromedriver": { "<job_id>": <true when every failure in the shard log is ChromeDriver refusing> } }
#
# Knapsack re-runs only the failed examples of a retried RSpec shard, and nothing
# of a cancelled one. So a retry is safe only when every shard finished and each
# red RSpec shard failed in examples: an error outside examples (a hook, a load
# error) has no example to retry, and its re-run would pass with 0 examples.
#
# `--rspec-shards` prints the job ids whose summary lines the caller must fetch.
# `--test-step-failures` prints the shards that failed in their test step, whose
# summary lines `--spec-failed` needs. `--spec-failed` prints true when one of
# them reported failing tests, null when one printed no summary (a timeout, or
# a load error that stopped the runner: it cannot tell which), and false
# otherwise. `--declined-log <log>` prints whether a shard log shows a declined
# test card, and `--card-declined` prints true when most of the failed shards
# did, which points at the shared Stripe test account. `--chromedriver-log <log>`
# prints whether every failure in a shard log is a refused connection to
# ChromeDriver, and `--chromedriver-down` prints true when that holds for every
# shard that failed in its test step.
#
# Exit codes match bin/classify-hung-checkout: 0 rerun, 1 skip, 2 could not run.

require "json"

EXIT_SKIP = 1
EXIT_OPERATIONAL = 2

SHARD_NAME = /\ATest (Fast|Slow|Minitest) \d+\z/
# The step that runs the shard's tests, per job in tests.yml.
SPEC_STEPS = { "Fast" => "Run tests", "Slow" => "Run tests", "Minitest" => "Run Minitest" }.freeze
RSPEC_KINDS = %w[Fast Slow].freeze
# "45 examples, 1 failure" or "45 examples, 1 failure, 2 pending". Anything more
# ("…, 1 error occurred outside of examples") is not retryable.
EXAMPLE_FAILURES = /\A\d+ examples?, ([1-9]\d*) failures?(, \d+ pending)?\z/

# More red shards than this reads as a real break, and re-running it only delays
# the red.
MAX_FAILED_SHARDS = 2

# A blocked test card is what a failed check found: after "Also found" or `" in "`
# in a Capybara message, or after `got:` in an RSpec one. A spec that expects the
# decline prints it as the expected value or in its source line, which do not count.
DECLINED = "Your card was declined."
FOUND_DECLINE = [/Also found .*#{Regexp.escape(DECLINED)}/, /\bgot: .*#{Regexp.escape(DECLINED)}/, /" in ".*#{Regexp.escape(DECLINED)}/].freeze

# A refused connection to ChromeDriver's default port: the driver process died,
# and every browser spec after it fails the same way, whatever the code.
CHROMEDRIVER_REFUSED = ["Errno::ECONNREFUSED", "127.0.0.1:9515"].freeze
LOG_TIMESTAMP = /\A\d{4}-\d\d-\d\dT\S+Z /
BACKTRACE_LINE = %r{\A# [./]}

FAILED = %w[failure timed_out].freeze
JOB_RED = %w[failure timed_out startup_failure cancelled].freeze

def steps_of(job)
  Array(job["steps"]).sort_by { |step| step["number"] || 0 }
end

def first_failed_step(job)
  steps_of(job).find { |step| FAILED.include?(step["conclusion"]) }
end

def job_label(job)
  job["name"] || "job #{job['id']}"
end

def shard_kind(job)
  job_label(job)[SHARD_NAME, 1]
end

def spec_step(job)
  SPEC_STEPS.fetch(shard_kind(job))
end

# An error outside examples (a load error, a hook) counts here: the code caused
# it, even though a retry could not re-run it.
RSPEC_SUMMARY = /\A\d+ examples?, (\d+) failures?(?:, \d+ pending)?(?:, (\d+) errors? occurred outside of examples)?\z/
MINITEST_SUMMARY = /\A\d+ runs, \d+ assertions, (\d+) failures, (\d+) errors, \d+ skips\z/

def test_step_failures(jobs)
  jobs.select do |job|
    next false unless job["conclusion"] == "failure" && job_label(job).match?(SHARD_NAME)
    step = first_failed_step(job)
    step && step["name"] == spec_step(job)
  end
end

def reported_failures?(summary)
  match = summary.to_s.strip.match(RSPEC_SUMMARY) || summary.to_s.strip.match(MINITEST_SUMMARY)
  !match.nil? && match.captures.any? { |count| count.to_i.positive? }
end

def summary_counts?(summary)
  summary.to_s.strip.match?(RSPEC_SUMMARY) || summary.to_s.strip.match?(MINITEST_SUMMARY)
end

# A job that hit its own time limit while its test step ran: the job reads
# `timed_out` and the step `cancelled`, with no summary to read.
def test_step_timeouts(jobs)
  jobs.select do |job|
    next false unless job["conclusion"] == "timed_out" && job_label(job).match?(SHARD_NAME)
    steps_of(job).any? { |step| step["name"] == spec_step(job) && %w[failure cancelled].include?(step["conclusion"]) }
  end
end

def spec_failed(jobs, summaries)
  failed = test_step_failures(jobs).map { |job| summaries[job["id"].to_s] }
  return true if failed.any? { |summary| reported_failures?(summary) }
  return nil if failed.any? { |summary| !summary_counts?(summary) } || test_step_timeouts(jobs).any?
  false
end

def declined_log?(text)
  text.each_line.any? { |line| line.include?(DECLINED) && FOUND_DECLINE.any? { |found| line.match?(found) } }
end

# Each RSpec failure starts at "Failure/Error:"; its error ends where its
# backtrace starts. A log with no failure list proves nothing.
def chromedriver_log?(text)
  lines = text.each_line.map { |line| line.gsub(/\e\[[0-9;]*m/, "").sub(LOG_TIMESTAMP, "").strip }
  start = lines.index("Failures:")
  return false unless start
  errors = lines[start..].take_while { |line| !line.start_with?("Finished in ") }
                         .slice_before { |line| line.include?("Failure/Error:") }.drop(1)
  errors.any? && errors.all? do |error|
    head = error.take_while { |line| !line.match?(BACKTRACE_LINE) }.join("\n")
    CHROMEDRIVER_REFUSED.all? { |part| head.include?(part) }
  end
end

# Every shard that failed in its test step, so a timeout or a shard with no
# summary leaves the answer false: nothing shows ChromeDriver failed it.
def chromedriver_down(jobs, refused)
  failed = test_step_failures(jobs)
  failed.any? && test_step_timeouts(jobs).empty? && failed.all? { |job| refused[job["id"].to_s] == true }
end

# A blocked test card declines every checkout, so it fails specs in most red shards
# at once. Up to MAX_FAILED_SHARDS red shards get a retry instead.
def card_declined(jobs, declines)
  failed = test_step_failures(jobs)
  declined = failed.count { |job| declines[job["id"].to_s] == true }
  declined > MAX_FAILED_SHARDS && declined * 2 > failed.size
end

def failed_rspec_shards(jobs)
  jobs.select { |job| job["conclusion"] == "failure" && RSPEC_KINDS.include?(shard_kind(job)) }
end

def verdict(payload)
  jobs = Array(payload["jobs"])

  # `cancelled` is a run someone threw away on purpose, or a newer push evicted.
  conclusion = payload["conclusion"]
  return [EXIT_SKIP, "skip: the attempt concluded #{conclusion.inspect}"] unless conclusion == "failure"

  unless payload["event"] == "push" && payload["head_branch"] == "main"
    return [EXIT_SKIP, "skip: not a main push (#{payload['event'].inspect} on #{payload['head_branch'].inspect})"]
  end

  # Not limited to main's tip: an early deploy can ship any commit before its
  # suite ends.
  red = jobs.select { |job| JOB_RED.include?(job["conclusion"]) }
  return [EXIT_SKIP, "skip: no red job on this attempt"] if red.empty?

  cancelled = red.find { |job| job["conclusion"] == "cancelled" }
  return [EXIT_SKIP, "skip: #{job_label(cancelled)} was cancelled, and a re-run would not run its remaining tests"] if cancelled

  # `timed_out` is a shard that ran out of its own budget; a re-run of a hang
  # proves nothing about the specs.
  red.each do |job|
    return [EXIT_SKIP, "skip: #{job_label(job)} is not a spec shard"] unless job_label(job).match?(SHARD_NAME)
    step = first_failed_step(job)
    unless job["conclusion"] == "failure" && step && step["name"] == spec_step(job) && step["conclusion"] == "failure"
      return [EXIT_SKIP, "skip: #{job_label(job)} failed at #{step&.dig('name').inspect}, not #{spec_step(job).inspect}"]
    end
  end

  if red.size > MAX_FAILED_SHARDS
    return [EXIT_SKIP, "skip: #{red.size} shards failed (limit #{MAX_FAILED_SHARDS})"]
  end

  summaries = payload["summaries"].is_a?(Hash) ? payload["summaries"] : {}
  failed_rspec_shards(red).each do |job|
    summary = summaries[job["id"].to_s].to_s.strip
    unless summary.match?(EXAMPLE_FAILURES)
      return [EXIT_SKIP, "skip: #{job_label(job)} summary #{summary.inspect} is not an example failure"]
    end
  end

  [0, "rerun: specs failed on #{red.map { |job| job_label(job) }.join(', ')}"]
end

raw = ARGV.reject { |arg| arg.start_with?("--") }.first
rspec_shards_only = ARGV.include?("--rspec-shards")
spec_failed_only = ARGV.include?("--spec-failed")
card_declined_only = ARGV.include?("--card-declined")
chromedriver_down_only = ARGV.include?("--chromedriver-down")
test_step_failures_only = ARGV.include?("--test-step-failures")

# A shard log, not a JSON payload.
LOG_FLAGS = { "--declined-log" => :declined_log?, "--chromedriver-log" => :chromedriver_log? }.freeze
if (log_check = LOG_FLAGS[ARGV.find { |arg| LOG_FLAGS.key?(arg) }])
  begin
    puts send(log_check, File.binread(raw).force_encoding("UTF-8").scrub)
    exit 0
  rescue TypeError, SystemCallError => e
    warn "Main spec-failure classifier could not read the log: #{e.message}"
    exit EXIT_OPERATIONAL
  end
end

begin
  # API payloads carry commit messages; the runner's locale may not be UTF-8.
  payload = JSON.parse(raw ? File.read(raw, encoding: "UTF-8") : $stdin.read.force_encoding("UTF-8"))
rescue JSON::ParserError, Errno::ENOENT, EncodingError => e
  warn "Main spec-failure classifier could not run: #{e.message}"
  exit EXIT_OPERATIONAL
end

unless payload.is_a?(Hash)
  warn "Main spec-failure classifier could not run: expected a JSON object"
  exit EXIT_OPERATIONAL
end

if test_step_failures_only
  test_step_failures(Array(payload["jobs"])).each { |job| puts job["id"] }
  exit 0
end

if spec_failed_only
  puts JSON.dump(spec_failed(Array(payload["jobs"]), payload["summaries"].is_a?(Hash) ? payload["summaries"] : {}))
  exit 0
end

if card_declined_only
  puts JSON.dump(card_declined(Array(payload["jobs"]), payload["declines"].is_a?(Hash) ? payload["declines"] : {}))
  exit 0
end

if chromedriver_down_only
  puts JSON.dump(chromedriver_down(Array(payload["jobs"]), payload["chromedriver"].is_a?(Hash) ? payload["chromedriver"] : {}))
  exit 0
end

if rspec_shards_only
  failed_rspec_shards(Array(payload["jobs"])).each { |job| puts job["id"] }
  exit 0
end

code, message = verdict(payload)
puts message
exit code
