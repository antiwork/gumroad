#!/usr/bin/env ruby
# frozen_string_literal: true

# Decides whether a failed `Tests` attempt on a `main` push gets one unattended
# re-run of its failed spec shards. A red `main` run never unblocks its deploy, so
# one random spec failure holds production until the next merge.
#
# Reads the attempt on stdin, or from a file argument:
#
#   { "jobs": [ ... GET /repos/{repo}/actions/runs/{id}/attempts/{n}/jobs ... ],
#     "conclusion": "<the triggering run's own conclusion>",
#     "event": "push", "head_branch": "main",
#     "head_sha": "<the run's commit>", "main_sha": "<main's tip now>",
#     "summaries": { "<job_id>": "<the shard log's last RSpec summary line>" } }
#
# Knapsack re-runs only the failed examples of a retried RSpec shard, and nothing
# of a cancelled one. So a retry is safe only when every shard finished and each
# red RSpec shard failed in examples: an error outside examples (a hook, a load
# error) has no example to retry, and its re-run would pass with 0 examples.
#
# `--rspec-shards` prints the job ids whose summary lines the caller must fetch.
#
# Exit codes match bin/classify-hung-checkout: 0 rerun, 1 skip, 2 could not run.

require "json"

EXIT_SKIP = 1
EXIT_OPERATIONAL = 2

SHARD_NAME = /\ATest (Fast|Slow|Minitest) \d+\z/
# The step that runs the shard's tests, per job in tests.yml.
SPEC_STEPS = { "Fast" => "Run tests", "Slow" => "Run tests", "Minitest" => "Run Minitest" }.freeze
RSPEC_KINDS = %w[Fast Slow].freeze
# "45 examples, 1 failure" or "45 examples, 1 failure, 2 pending". Anything more
# ("…, 1 error occurred outside of examples") is not retryable.
EXAMPLE_FAILURES = /\A\d+ examples?, ([1-9]\d*) failures?(, \d+ pending)?\z/

# More red shards than this reads as a real break, and re-running it only delays
# the red.
MAX_FAILED_SHARDS = 2

FAILED = %w[failure timed_out].freeze
JOB_RED = %w[failure timed_out startup_failure cancelled].freeze

def steps_of(job)
  Array(job["steps"]).sort_by { |step| step["number"] || 0 }
end

def first_failed_step(job)
  steps_of(job).find { |step| FAILED.include?(step["conclusion"]) }
end

def job_label(job)
  job["name"] || "job #{job['id']}"
end

def shard_kind(job)
  job_label(job)[SHARD_NAME, 1]
end

def spec_step(job)
  SPEC_STEPS.fetch(shard_kind(job))
end

def failed_rspec_shards(jobs)
  jobs.select { |job| job["conclusion"] == "failure" && RSPEC_KINDS.include?(shard_kind(job)) }
end

def verdict(payload)
  jobs = Array(payload["jobs"])

  # `cancelled` is a run someone threw away on purpose, or a newer push evicted.
  conclusion = payload["conclusion"]
  return [EXIT_SKIP, "skip: the attempt concluded #{conclusion.inspect}"] unless conclusion == "failure"

  unless payload["event"] == "push" && payload["head_branch"] == "main"
    return [EXIT_SKIP, "skip: not a main push (#{payload['event'].inspect} on #{payload['head_branch'].inspect})"]
  end

  # A newer main commit contains this one, and its own run unblocks the deploy
  # that ships both. Re-running here would only add a second deploy.
  head_sha = payload["head_sha"].to_s
  main_sha = payload["main_sha"].to_s
  if head_sha.empty? || head_sha != main_sha
    return [EXIT_SKIP, "skip: #{head_sha[0, 12].inspect} is no longer main's tip (#{main_sha[0, 12].inspect})"]
  end

  red = jobs.select { |job| JOB_RED.include?(job["conclusion"]) }
  return [EXIT_SKIP, "skip: no red job on this attempt"] if red.empty?

  cancelled = red.find { |job| job["conclusion"] == "cancelled" }
  return [EXIT_SKIP, "skip: #{job_label(cancelled)} was cancelled, and a re-run would not run its remaining tests"] if cancelled

  # `timed_out` is a shard that ran out of its own budget; a re-run of a hang
  # proves nothing about the specs.
  red.each do |job|
    return [EXIT_SKIP, "skip: #{job_label(job)} is not a spec shard"] unless job_label(job).match?(SHARD_NAME)
    step = first_failed_step(job)
    unless job["conclusion"] == "failure" && step && step["name"] == spec_step(job) && step["conclusion"] == "failure"
      return [EXIT_SKIP, "skip: #{job_label(job)} failed at #{step&.dig('name').inspect}, not #{spec_step(job).inspect}"]
    end
  end

  if red.size > MAX_FAILED_SHARDS
    return [EXIT_SKIP, "skip: #{red.size} shards failed (limit #{MAX_FAILED_SHARDS})"]
  end

  summaries = payload["summaries"].is_a?(Hash) ? payload["summaries"] : {}
  failed_rspec_shards(red).each do |job|
    summary = summaries[job["id"].to_s].to_s.strip
    unless summary.match?(EXAMPLE_FAILURES)
      return [EXIT_SKIP, "skip: #{job_label(job)} summary #{summary.inspect} is not an example failure"]
    end
  end

  [0, "rerun: specs failed on #{red.map { |job| job_label(job) }.join(', ')}"]
end

raw = ARGV.reject { |arg| arg.start_with?("--") }.first
rspec_shards_only = ARGV.include?("--rspec-shards")

begin
  payload = JSON.parse(raw ? File.read(raw) : $stdin.read)
rescue JSON::ParserError, Errno::ENOENT => e
  warn "Main spec-failure classifier could not run: #{e.message}"
  exit EXIT_OPERATIONAL
end

unless payload.is_a?(Hash)
  warn "Main spec-failure classifier could not run: expected a JSON object"
  exit EXIT_OPERATIONAL
end

if rspec_shards_only
  failed_rspec_shards(Array(payload["jobs"])).each { |job| puts job["id"] }
  exit 0
end

code, message = verdict(payload)
puts message
exit code
