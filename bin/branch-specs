# Config files with dedicated, local coverage. Boot-global files (domain.rb,
# currencies.json, secure_headers, test_redis_isolation, devise/sentry/filter
# hooks, OmniAuth Apple) stay in ESCALATE_PATTERNS — a matching
# spec/config/*_spec.rb is not proof the initializer's effect is local.
CONFIG_SPEC_MAP = {
  "config/initializers/rack_attack.rb" => %w[spec/requests/rack_attack_spec.rb],
  "config/initializers/alterity.rb" => %w[spec/config/initializers/alterity_spec.rb],
  "config/initializers/instant_ddl_first.rb" => %w[spec/config/initializers/instant_ddl_first_spec.rb],
  "config/initializers/active_storage_jobs.rb" => %w[spec/config/initializers/active_storage_jobs_spec.rb],
}.freeze

# Support files with mappings; any OTHER spec/support change escalates.
MAPPED_SUPPORT = FANOUT.keys.select { |re| re.source.start_with?('\Aspec/support') }.freeze

# Paths that cannot be attributed to specs by filename: run the full suite.
# Blanket config/ stays: a spec/config twin is not enough for boot-global
# files (domain, CSP, currencies, test redis, Warden/Sentry hooks).
# CONFIG_SPEC_MAP is the only reviewed exception.
ESCALATE_PATTERNS = [
  %r{\AGemfile},
  %r{\Aconfig/},
  # db/ is not listed: additive_db_specs classifies every db/ path and
  # escalates the ones it cannot clear.
  %r{\Apackage\.json\z},
  %r{\A(pnpm-lock\.yaml|yarn\.lock|package-lock\.json)\z},
  %r{\Atsconfig},
  %r{\Aspec/factories/},
  %r{\Aspec/spec_helper\.rb\z},
  %r{\Aspec/rails_helper\.rb\z},
  %r{\Avite\.config},
  %r{\A\.github/workflows/tests\.yml\z},
  # Escalated here rather than via the mapping gap, which is computed after the
  # co-located-vitest shortcut: a .test.tsx beside one of these would silently
  # drop it to the user_spec.rb floor.
  %r{\Aapp/javascript/components/DownloadPage/(Layout|WithContent)\.tsx\z},
  %r{\Aapp/javascript/pages/UrlRedirects/Read\.tsx\z},
].freeze

# Paths that never affect the rspec suite.
IGNORED_PATTERNS = [
  # Minitest suite; test_minitest runs all of it on every PR, unfiltered.
  %r{\Atest/},
  %r{\Aqa-media/},
  %r{\Adocs?/},
  %r{\.md\z},
  %r{\A\.agents/},
  %r{\A\.claude/},
  # Static assets; rspec does not compile public/.
  %r{\Apublic/},
  # Other workflows are not the rspec suite. tests.yml still escalates via
  # ESCALATE_PATTERNS (checked after this filter).
  %r{\A\.github/workflows/(?!tests\.yml)},
  # Recorded HTTP, not helpers. A cassette-only diff must not force Slow;
  # the spec that plays the tape is already in the selection (or unchanged).
  %r{\Aspec/support/fixtures/vcr_cassettes/},
  # Production nginx/startup/local-compose only. Test-image inputs
  # (Dockerfile.test, compose-test-and-ci, docker/ci, rspec.sh, fixture
  # manifests) are unattributed and escalate — they feed the rspec image.
  %r{\Adocker/(nginx|branch_app_nginx)/},
  %r{\Adocker/web/(server|sidekiq_worker|rpush|post_deployment|database_migration|compile_assets|push_assets_to_s3|setup_db)\.sh\z},
  %r{\Adocker/docker-compose-local\.yml\z},
  # Buildkite runs preview and production deploys only; rspec runs in GitHub
  # Actions and reads nothing under .buildkite/.
  %r{\A\.buildkite/},
].freeze

# Above this many selected files the full suite's parallelism wins anyway.
MAX_SELECTED_FILES = 120

ESCALATE_EXIT = 3

def escalate!(reason)
  warn "bin/branch-specs: ESCALATE — #{reason}"
  warn "Run the full suite instead: add the run-all-specs label to the PR."
  exit ESCALATE_EXIT
end

# Reads name UTF-8 so an ASCII-only locale cannot make them raise. Bytes that
# are no valid encoding we refuse rather than scrub: U+FFFD can name a different
# real file, which would quietly run the wrong spec.
def git(*args)
  out = IO.popen(["git", *args], err: File::NULL, external_encoding: "UTF-8", &:read)
  return [] unless $?.success?
  escalate!("git reported a path that is not valid UTF-8") unless out.valid_encoding?
  out.split("\n")
end

base = "origin/main"
base_given = false
smoke = false

argv = ARGV.dup
until argv.empty?
  case (arg = argv.shift)
  when "--base"
    base = argv.shift or abort("--base requires a ref")
    base_given = true
  when "--smoke" then smoke = true
  when "--no-smoke" then smoke = false # kept for compatibility
  when "-h", "--help"
    # The header block above contains em-dashes, so this read needs UTF-8 too.
    doc = File.read(__FILE__, encoding: "UTF-8").lines
      .drop_while { |line| line.start_with?("#!") || line.include?("frozen_string_literal") || line.strip.empty? }
      .take_while { |line| line.start_with?("#") }
    puts doc.join.gsub(/^# ?/, "")
    exit 0
  else
    abort("bin/branch-specs: unknown argument #{arg.inspect}")
  end
end

if git("rev-parse", "--verify", "--quiet", base).empty?
  abort("bin/branch-specs: base ref #{base.inspect} does not resolve") if base_given
  base = "main"
  abort("bin/branch-specs: neither origin/main nor main resolves") if git("rev-parse", "--verify", "--quiet", base).empty?
end
merge_base = git("merge-base", base, "HEAD").first

changed = Set.new
changed.merge(git("diff", "--name-only", "#{merge_base}..HEAD")) if merge_base
changed.merge(git("diff", "--name-only", "HEAD"))
changed.merge(git("ls-files", "--others", "--exclude-standard"))

cassette_in_diff = changed.any? { |path| path.start_with?("spec/support/fixtures/vcr_cassettes/") }
changed.reject! { |path| IGNORED_PATTERNS.any? { |re| re.match?(path) } }
# Cassettes ride along with a mapped spec without forcing Slow. A cassette-only
# diff has nothing left to attribute, so escalate rather than run zero specs.
escalate!("cassette-only diff: map to the owning spec or add run-all-specs") if changed.empty? && cassette_in_diff

db_paths = changed.select { |path| path.start_with?("db/") }

unmappable = changed.select do |path|
  ESCALATE_PATTERNS.any? { |re| re.match?(path) } && !CONFIG_SPEC_MAP.key?(path)
end
escalate!("cannot attribute specs to: #{unmappable.first(5).join(', ')}") if unmappable.any?

unmapped_support = changed.select do |path|
  path.start_with?("spec/support/") && MAPPED_SUPPORT.none? { |re| re.match?(path) }
end
escalate!("unmapped spec/support change: #{unmapped_support.first(3).join(', ')}") if unmapped_support.any?

# Content attribution fallback for Ruby files whose spec lives under a
# different name. Camelizes the basename (colombia_id_number →
# ColombiaIdNumber) and greps specs for either form. Word-boundary anchored
# so short names don't false-positive.
def specs_mentioning(*basenames)
  names = basenames.flat_map { |basename| [basename, basename.split("_").map(&:capitalize).join] }
  pattern = "\\b(#{names.map { |name| Regexp.escape(name) }.join('|')})\\b"
  # grep prints path bytes unescaped, so the same rule as git() applies here.
  out = IO.popen(["grep", "-rlE", pattern, "spec/", "--include=*_spec.rb"], err: File::NULL, external_encoding: "UTF-8", &:read)
  return [] unless $?.success?
  escalate!("grep reported a spec path that is not valid UTF-8") unless out.valid_encoding?
  out.split("\n")
end

def grep_files(pattern, root)
  # Same encoding rule as git(): name UTF-8, refuse bytes that are not.
  out = IO.popen(["grep", "-rlE", pattern, root], err: File::NULL, external_encoding: "UTF-8", &:read)
  return [] unless $?.success?
  escalate!("grep reported a path that is not valid UTF-8") unless out.valid_encoding?
  out.split("\n")
end

def mailer_subclassed?(mailer)
  camel = mailer.split("_").map(&:capitalize).join
  grep_files("<\\s*#{Regexp.escape(camel)}\\b", "app/mailers/").any?
end

# Files that render a template. A qualified render spells out the whole key
# (customer_mailer/receipt/item); a bare one names only the partial and Rails
# resolves it against the mailer's prefix, so it can reach a top-level partial
# only, and only from that mailer's own templates.
def template_referrers(view)
  owner, rest = view.delete_prefix("app/views/").split("/", 2)
  key = "#{owner}/#{rest.sub(%r{\.[^/]*\z}, '').sub(%r{(\A|/)_}, '\1')}"
  refs = grep_files("[\"']#{Regexp.escape(key)}[\"']", "app/")
  bare = rest[%r{\A_([^/]+?)\.}, 1]
  refs += grep_files("[\"']#{Regexp.escape(bare)}[\"']", "app/views/#{owner}/") if bare
  refs.uniq - [view]
end

# A mailer template is covered by spec/mailers/<mailer>_spec.rb, keyed on the
# first path segment: partials nest deeper (customer_mailer/receipt/sections/
# _header.html.erb) and still belong to customer_mailer.
#
# Naming only that owner is not enough, because templates cross mailers:
# customer_low_priority_mailer renders customer_mailer/receipt/sections/items,
# and receipt/_item reaches it one level further down. So walk the render graph
# up from the changed template and collect every mailer it can be reached from.
# A referrer that is not a mailer view ends the walk with no answer — the
# receipt previews controller renders customer_mailer/receipt, and no mailer
# spec covers that — so the caller escalates, as it does today.
def mailer_view_specs(path)
  owner = path[%r{\Aapp/views/([^/]+)/.+\z}, 1]
  return [] unless owner && File.exist?("app/mailers/#{owner}.rb")

  mailers = [owner]
  seen = [path]
  queue = [path]
  until queue.empty?
    template_referrers(queue.shift).each do |ref|
      next if seen.include?(ref)
      seen << ref
      case ref
      when %r{\Aapp/views/([^/]+)/}
        return [] unless File.exist?("app/mailers/#{$1}.rb")
        mailers << $1
        queue << ref
      when %r{\Aapp/mailers/([^/]+)\.rb\z}
        mailers << $1
      else
        return []
      end
    end
  end

  # A mailer other mailers inherit from lends its prefix to their bare renders,
  # so its templates are reachable from view trees this walk never visits.
  return [] if mailers.uniq.any? { |m| mailer_subclassed?(m) }

  covered = mailers.uniq.map do |m|
    (["spec/mailers/#{m}_spec.rb"] + Dir.glob("spec/mailers/#{m}/**/*_spec.rb")).select { |s| File.exist?(s) }
  end
  # One uncovered mailer in the graph is enough to escalate. Returning the rest
  # would let the owner's own spec stand in for coverage that does not exist.
  return [] if covered.any?(&:empty?)

  covered.flatten
end

def spec_candidates(path)
  case path
  when %r{\Aspec/.*_spec\.rb\z}
    [path]
  when %r{\Aapp/controllers/(.*)_controller\.rb\z}
    nested = $1
    flat = nested.tr("/", "_")
    [
      "spec/controllers/#{nested}_controller_spec.rb",
      "spec/requests/#{nested}_spec.rb",
      "spec/controllers/#{flat}_controller_spec.rb",
      "spec/requests/#{flat}_spec.rb"
    ].uniq
  when %r{\Aapp/(models|services)/(.*/)?([^/]+)\.rb\z}
    # Unit specs (exact name, name-prefixed, and split-by-concern subdir)
    # plus any request specs named after the model/service, so a money-path
    # change pulls its end-to-end coverage into the run.
    unit = ["spec/#{$1}/#{$2}#{$3}_spec.rb"] +
      Dir.glob("spec/#{$1}/#{$2}#{$3}_*_spec.rb") +
      Dir.glob("spec/#{$1}/#{$2}#{$3}/**/*_spec.rb")
    e2e = Dir.glob("spec/requests/**/#{$3}*_spec.rb")
    unit + e2e
  when "app/views/layouts/custom_styles/styles.scss.erb"
    # Read only by SellerProfile#custom_styles (File.read), which every themed
    # surface calls. Specs that name custom_styles cover the compiled output.
    specs_mentioning("custom_styles")
  when %r{\Aapp/views/(([^/]+)(?:/.*)?)/[^/]+\z}
    # A mailer's templates are attributed by the render graph alone. Adding the
    # request/view globs here would let an unrelated spec keep the caller from
    # escalating on a graph the walk could not resolve.
    if File.exist?("app/mailers/#{$2}.rb")
      mailer_view_specs(path)
    else
      Dir.glob("spec/requests/#{$1}*_spec.rb") +
        Dir.glob("spec/requests/#{$1.tr('/', '_')}*_spec.rb") +
        Dir.glob("spec/views/#{$1}/**/*_spec.rb")
    end
  when %r{\Aapp/([^/]+)/(.*)\.rb\z}
    ["spec/#{$1}/#{$2}_spec.rb"]
  when %r{\Alib/(.*)\.rb\z}
    ["spec/lib/#{$1}_spec.rb"]
  else
    []
  end
end

MIGRATION_PATH = %r{\Adb/migrate/\d+_[a-z0-9_]+\.rb\z}
SCHEMA_PATH = "db/schema.rb"
SCHEMA_DEFINE_LINE = /\AActiveRecord::Schema\[[\d.]+\]\.define\(version: [\d_]+\) do\z/

# Column and index calls a `t` block may make on a table. Removals, renames,
# type changes, and virtual columns are absent on purpose.
ADDITIVE_TABLE_CALLS = %w[
  string text longtext integer bigint float decimal numeric datetime timestamp time date
  binary boolean json blob column references belongs_to timestamps index
].freeze

# Ripper nodes for the literal values a purely additive migration may pass.
# Anything that can run code (constants, calls, interpolation) is rejected.
def literal_node?(node)
  case node[0]
  when :symbol_literal, :@int, :@float then true
  when :string_literal then node[1][1..].all? { |part| part[0] == :@tstring_content }
  when :var_ref then node[1][0] == :@kw && %w[true false nil].include?(node[1][1])
  when :unary then node[1] == :-@ && %i[@int @float].include?(node[2][0])
  when :array then (node[1] || []).all? { |element| literal_node?(element) }
  when :bare_assoc_hash
    node[1].all? do |pair|
      pair[0] == :assoc_new && (pair[1][0] == :@label || literal_node?(pair[1])) && literal_node?(pair[2])
    end
  else false
  end
end

# Name of a symbol or plain string literal, nil for anything else.
def literal_name(node)
  case node[0]
  when :symbol_literal then node[1][1][1]
  when :string_literal
    parts = node[1][1..]
    parts[0][1] if parts.size == 1 && parts[0][0] == :@tstring_content
  end
end

def call_options(args)
  last = args.last
  return {} unless last && last[0] == :bare_assoc_hash

  last[1].to_h { |pair| [pair[1][0] == :@label ? pair[1][1].chomp(":") : literal_name(pair[1]), pair[2]] }
end

def option_false?(options, key)
  node = options[key]
  !node.nil? && node[0] == :var_ref && node[1][1] == "false"
end

# A NOT NULL column with no usable default makes every other insert into that
# table fail, including inserts from specs that never mention its model.
# `default: nil` supplies no value, so it counts as no default.
def not_null_without_default?(options)
  default = options["default"]
  has_default = !default.nil? && !(default[0] == :var_ref && default[1][1] == "nil")
  option_false?(options, "null") && !has_default
end

# Timestamp columns on an existing table are NOT NULL unless the call says otherwise.
def nullable_option?(options)
  node = options["null"]
  !node.nil? && node[0] == :var_ref && node[1][1] == "true"
end

# A unique index on an existing table can reject rows that unrelated specs create.
def unique_index?(options)
  options.key?("unique") && !option_false?(options, "unique")
end

def call_args(node)
  node = node[1] if node && node[0] == :arg_paren
  return [] if node.nil?

  node[0] == :args_add_block && node[2] == false ? node[1] : nil
end

# [receiver, method name, argument nodes (nil when unsupported), block] for a
# call statement, nil for any other statement.
def call_parts(node)
  block = nil
  if node[0] == :method_add_block
    block = node[2]
    node = node[1]
  end

  case node[0]
  when :command then [nil, node[1][1], call_args(node[2]), block]
  when :command_call then [node[1], node[3][1], call_args(node[4]), block]
  when :call then [node[1], node[3][1], [], block] if node[3][0] == :@ident
  when :method_add_arg
    target = node[1]
    case target[0]
    when :fcall then [nil, target[1][1], call_args(node[2]), block]
    when :call then [target[1], target[3][1], call_args(node[2]), block] if target[3][0] == :@ident
    end
  end
end

# [block parameter name, statements] for a block with exactly one plain parameter.
def table_block_parts(block)
  case block[0]
  when :do_block
    return unless block[2][2..].all?(&:nil?)

    variable, statements = block[1], block[2][1]
  when :brace_block
    variable, statements = block[1], block[2]
  else
    return
  end
  return unless variable && variable[0] == :block_var && variable[2] == false

  params = variable[1]
  return unless params[1]&.size == 1 && params[2..].all?(&:nil?) && params[1][0][0] == :@ident

  [params[1][0][1], statements]
end

def additive_table_block?(block, new_table:)
  parts = table_block_parts(block) or return false
  variable, statements = parts
  statements.all? do |statement|
    receiver, name, args, nested = call_parts(statement)
    next false unless receiver && receiver[0] == :var_ref && receiver[1][1] == variable
    next false unless nested.nil? && args && args.all? { |arg| literal_node?(arg) }
    next false unless ADDITIVE_TABLE_CALLS.include?(name)

    options = call_options(args)
    case name
    when "index" then new_table || !unique_index?(options)
    when "timestamps" then new_table || nullable_option?(options)
    else new_table || !not_null_without_default?(options)
    end
  end
end

# Tables an additive statement touches, nil when the statement is anything else.
def additive_statement_tables(statement)
  receiver, name, args, block = call_parts(statement)
  return unless receiver.nil? && name && args && args.all? { |arg| literal_node?(arg) }

  table = args[0] && literal_name(args[0])
  return unless table

  options = call_options(args)
  additive =
    case name
    when "add_column" then block.nil? && args.size >= 3 && !not_null_without_default?(options)
    when "add_index" then block.nil? && args.size >= 2 && !unique_index?(options)
    # force: true drops the existing table first.
    when "create_table" then !options.key?("force") && (block.nil? || additive_table_block?(block, new_table: true))
    when "change_table" then !block.nil? && additive_table_block?(block, new_table: false)
    end
  [table] if additive
end

def const_tokens(node)
  return [] unless node.is_a?(Array)
  return [node[1]] if %i[@const @float].include?(node[0])

  node.flat_map { |child| const_tokens(child) }
end

# Tables an additive migration adds to or creates, nil when the migration does
# anything else. A migration qualifies when it is one class with a lone
# `change` or `up` whose statements are all add_column, add_index,
# create_table, or change_table with additions only.
def additive_migration_tables(path)
  return unless File.file?(path)

  program = Ripper.sexp(File.read(path, encoding: "UTF-8")) or return
  return unless program[1].size == 1 && program[1][0][0] == :class

  _, _, superclass, body = program[1][0]
  tokens = const_tokens(superclass)
  return unless tokens.size == 3 && tokens[0..1] == %w[ActiveRecord Migration] && tokens[2].match?(/\A\d+\.\d+\z/)
  return unless body[0] == :bodystmt && body[2..].all?(&:nil?) && body[1].size == 1

  definition = body[1][0]
  return unless definition[0] == :def && %w[change up].include?(definition[1][1])
  return unless definition[2][0] == :params && definition[2][1..].all?(&:nil?)
  return unless definition[3][2..].all?(&:nil?)

  tables = []
  definition[3][1].each do |statement|
    touched = additive_statement_tables(statement) or return
    tables.concat(touched)
  end
  tables.uniq unless tables.empty?
end

# Candidate spellings of a table's name: the table itself and the singular
# forms its model can take, so a spec that names either one is picked up.
def table_name_variants(table)
  variants = [table]
  variants << table.sub(/ies\z/, "y") if table.end_with?("ies")
  variants << table.delete_suffix("es") if table.match?(/(s|x|z|ch|sh)es\z/)
  variants << table.delete_suffix("s") if table.match?(/[^s]s\z/)
  variants.uniq
end

# Line ranges of the create_table blocks in db/schema.rb for the given tables.
def schema_table_ranges(lines, tables)
  lines.each_with_index.filter_map do |line, index|
    next unless (name = line[/\A  create_table "([^"]+)"/, 1]) && tables.include?(name)

    offset = lines[index..].index("  end")
    (index + 1)..(index + offset + 1) if offset
  end
end

# db/schema.rb may change only in the define(version:) line and inside the
# create_table blocks of tables an additive migration touches, plus blank
# separator lines. Nothing may be removed except the old define line.
def schema_change_covered?(merge_base, tables)
  return false unless merge_base && File.file?(SCHEMA_PATH)

  diff = git("diff", "-U0", "--no-color", merge_base, "--", SCHEMA_PATH)
  return false if diff.empty?

  ranges = schema_table_ranges(File.readlines(SCHEMA_PATH, chomp: true, encoding: "UTF-8"), tables)
  line_number = nil
  diff.all? do |line|
    if (hunk = line.match(/\A@@ -\d+(?:,\d+)? \+(\d+)/))
      line_number = hunk[1].to_i
      next true
    end
    next true if line_number.nil? || line.start_with?("\\")

    text = line[1..]
    if line.start_with?("-")
      text.match?(SCHEMA_DEFINE_LINE)
    else
      current = line_number
      line_number += 1
      # The dumper puts a blank line between tables, so a new table adds one.
      text.empty? || text.match?(SCHEMA_DEFINE_LINE) || ranges.any? { |range| range.cover?(current) }
    end
  end
end

# Specs for a diff that touches db/: [specs, nil], or [nil, reason] when the
# diff has to escalate. Every migration must be purely additive and have at
# least one spec that names its tables; schema.rb must show only the matching
# additions. The selection is by name, so it can miss a spec that reaches the
# table through a factory. Main's full-suite gate covers that miss.
def additive_db_specs(paths, merge_base)
  migrations = paths.select { |path| MIGRATION_PATH.match?(path) }
  other = paths - migrations - [SCHEMA_PATH]
  return [nil, "#{other.first} is not a migration or db/schema.rb"] if other.any?
  return [nil, "db/schema.rb changed without a migration"] if migrations.empty?

  tables = []
  specs = []
  migrations.each do |migration|
    touched = additive_migration_tables(migration)
    return [nil, "#{migration} is not a purely additive migration"] unless touched

    # Each table needs its own spec: a spec for one table must not cover another.
    touched.each do |table|
      found = specs_mentioning(*table_name_variants(table))
      return [nil, "no spec names #{table} (from #{migration})"] if found.empty?

      specs.concat(found)
    end
    tables.concat(touched)
  end

  if paths.include?(SCHEMA_PATH) && !schema_change_covered?(merge_base, tables.uniq)
    return [nil, "#{SCHEMA_PATH} changes more than the additive migration's tables"]
  end

  [specs.uniq, nil]
end

specs = Set.new
unattributed = []

if db_paths.any?
  db_specs, reason = additive_db_specs(db_paths, merge_base)
  escalate!("cannot attribute specs to db/ changes: #{reason}") unless db_specs
  specs.merge(db_specs)
  changed.subtract(db_paths)
end

changed.each do |path|
  candidates = spec_candidates(path).select { |s| File.exist?(s) }
  fanout_hits = FANOUT.select { |re, _| re.match?(path) }.values.flatten.select { |dir| Dir.exist?(dir) || File.exist?(dir) }
  config_hits = (CONFIG_SPEC_MAP[path] || []).select { |s| File.exist?(s) }
  contributed = candidates + fanout_hits + config_hits

  if contributed.any?
    specs.merge(contributed)
  elsif path.match?(%r{\Aapp/javascript/.*\.test\.(ts|tsx)\z}) ||
        path.match?(%r{\Aapp/javascript/.*\.d\.ts\z}) ||
        (path.match?(%r{\Aapp/javascript/.*\.(ts|tsx)\z}) &&
         File.exist?(path.sub(/\.(ts|tsx)\z/, '.test.\1'))) ||
        path == "app/javascript/components/EvaporateUploader.tsx" ||
        path == "vendor/assets/javascripts/evaporate.cjs"
    # Covered by vitest, which lint_js runs on every PR (npm test). A
    # co-located .test file is that module's suite; type-only .d.ts
    # files ride with the consuming module. Evaporate's context hook and
    # vendored client are exercised by useConfigureEvaporate vitest.
    # None of these need rspec.
    next
  elsif path.match?(%r{\Aspec/.*_spec\.rb\z}) && !File.exist?(path)
    # A deleted spec has nothing left to run. What it covered is still mapped
    # through the other paths in the diff; deleted support files and deleted
    # app code keep escalating.
    next
  elsif path == "bin/branch-specs" || path == "spec/bin/branch_specs_test.rb"
    # Standalone ruby test (ruby spec/bin/branch_specs_test.rb), not rspec.
    next
  elsif path == "bin/revert-red-main-decision" || path == "spec/bin/revert_red_main_decision_test.rb"
    # Same: standalone ruby (ruby spec/bin/revert_red_main_decision_test.rb), not rspec.
    next
  elsif path == "bin/classify-hung-checkout" || path == "spec/bin/classify_hung_checkout_test.rb"
    # Same: standalone ruby (ruby spec/bin/classify_hung_checkout_test.rb), not rspec.
    next
  elsif path == "bin/classify-main-spec-failure" || path == "spec/bin/classify_main_spec_failure_test.rb"
    # Same: standalone ruby (ruby spec/bin/classify_main_spec_failure_test.rb), not rspec.
    next
  elsif ["bin/deploy-before-main-suite", "bin/deploy-before-main-suite-gate", "spec/bin/deploy_before_main_suite_gate_test.rb",
         "bin/unblock-buildkite-deploy", "spec/bin/unblock_buildkite_deploy_test.rb"].include?(path)
    # Same: standalone ruby self-tests that the Migration versions job runs.
    next
  elsif path == "bin/reuse-full-suite" || path == "script/test-reuse-full-suite"
    # Standalone bash; script/test-reuse-full-suite runs on every PR.
    next
  elsif path == ".github/workflows/rerun-hung-checkout.yml"
    # Only invokes the classifier; the job `if` is asserted in that standalone
    # test. Other workflows still go through unattributed; tests.yml still
    # escalates via ESCALATE_PATTERNS.
    next
  elsif path.match?(%r{\A(lib|app)/.*\.rb\z}) &&
        (by_content = specs_mentioning(File.basename(path, ".rb"))).any?
    # Name-based mapping missed (spec lives under another name, e.g.
    # lib/utilities/compliance/colombia_id_number.rb tested via
    # update_user_compliance_info_spec.rb). Content attribution: any spec
    # that mentions the file's basename exercises it.
    specs.merge(by_content)
  else
    unattributed << path
  end
end

# Any changed path that contributed no specs of its own is a mapping gap, not
# a clean bill — even when OTHER paths in the same diff selected specs. This
# catches both a lone boot/test-infrastructure change (Rakefile, bin/rspec,
# .rspec, config.ru) and one hiding alongside a mapped file, where the old
# specs.empty? guard was fooled into thinking the diff was fully covered.
if unattributed.any?
  escalate!("diff touches #{unattributed.first(5).join(', ')} but no specs were selected for it (mapping gap)")
end

# Knapsack consumes a plain file list, so directories expand to their spec files.
specs = specs.flat_map { |s| Dir.exist?(s) ? Dir.glob("#{s}/**/*_spec.rb") : [s] }.uniq

specs |= SMOKE_SPECS.select { |spec| File.exist?(spec) } if smoke

escalate!("selection of #{specs.size} spec files exceeds #{MAX_SELECTED_FILES}") if specs.size > MAX_SELECTED_FILES

puts specs.sort
