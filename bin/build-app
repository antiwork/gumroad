#!/bin/bash
set -euo pipefail

# Check if SSL certificates exist FIRST
if [ ! -f "docker/local-nginx/certs/gumroad_dev.crt" ] || [ ! -f "docker/local-nginx/certs/gumroad_dev.key" ]; then
  echo "SSL certificates not found. Please generate them by running:"
  echo "  bin/generate_ssl_certificates"
  exit 1
fi

# Get versions from project files
RUBY_VERSION=$(cat .ruby-version 2>/dev/null | tr -d '[:space:]')
NODE_VERSION=$(cat .node-version 2>/dev/null | tr -d '[:space:]')
NPM_VERSION=$(grep -o '"npm@[^"]*"' package.json 2>/dev/null | head -1 | sed 's/"npm@\([^"]*\)"/\1/')

# Validate required versions
if [ -z "$RUBY_VERSION" ]; then
  echo "Error: Could not read Ruby version from .ruby-version"
  exit 1
fi
if [ -z "$NODE_VERSION" ]; then
  echo "Error: Could not read Node version from .node-version"
  exit 1
fi
if [ -z "$NPM_VERSION" ]; then
  echo "Error: Could not read NPM version from package.json (expected \"npm@<version>\" in packageManager field)"
  exit 1
fi

echo "Building Docker image with:"
echo "  Ruby: $RUBY_VERSION"
echo "  Node: $NODE_VERSION"
echo "  NPM:  $NPM_VERSION"

# Build the Docker image
docker build \
  --build-arg RUBY_VERSION="$RUBY_VERSION" \
  --build-arg NODE_VERSION="$NODE_VERSION" \
  --build-arg NPM_VERSION="$NPM_VERSION" \
  -f docker/app/Dockerfile \
  -t gumroad-app:latest \
  .

echo ""
echo "Docker image built successfully!"
echo "  Tagged as: gumroad-app:latest"
