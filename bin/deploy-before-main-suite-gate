#!/usr/bin/env ruby
# frozen_string_literal: true

# Decides whether a main push may unblock its deploy before its own Tests run
# finishes. Reads on stdin, or from a file argument:
#
#   { "sha": "<the pushed commit>",
#     "runs": [ ... Tests workflow runs for main pushes: those created in the
#               last 30 days plus every active one, duplicates allowed ... ],
#     "pulls": [ ... GET /repos/{repo}/commits/{sha}/pulls ... ],
#     "ci_green": "<state of ci/green on the merged PR's head, or empty>" }
#
# The freeze needs no stored state: while the newest finished main run is red,
# or a re-run of one is in flight, every deploy waits for its own suite. The
# next green run lifts it.
#
# Prints one `deploy-before-main-suite decision=… reason=…` line. Exit codes:
# 0 early, 1 wait for the suite, 2 could not run.

require "json"
require "time"

EXIT_WAIT = 1
EXIT_OPERATIONAL = 2

def updated_at(run)
  Time.iso8601(run["updated_at"].to_s)
rescue ArgumentError
  Time.at(0)
end

def created_at(run)
  Time.iso8601(run["created_at"].to_s)
rescue ArgumentError
  Time.at(0)
end

def merged_pull(pulls, sha)
  pulls.find { |pull| pull["merged_at"] && pull["merge_commit_sha"] == sha }
end

def verdict(payload)
  sha = payload["sha"].to_s
  return [EXIT_WAIT, "no_sha", {}] if sha.empty?

  # The same run can appear several times (recent list, active list, a fresh
  # read). The copy with the highest attempt, then the latest update, is the
  # truth; at a tie a finished copy beats a stale unfinished one.
  latest = Array(payload["runs"]).group_by { |run| run["id"] }.values.map do |copies|
    copies.max_by { |run| [run["run_attempt"].to_i, updated_at(run), run["status"] == "completed" ? 1 : 0] }
  end

  retrying = latest.find { |run| run["run_attempt"].to_i > 1 && run["status"] != "completed" }
  if retrying
    reason = retrying["head_sha"] == sha ? "own_retry_in_progress" : "frozen_retry_in_progress"
    return [EXIT_WAIT, reason, { run: retrying["id"] }]
  end

  # A cancelled first attempt was evicted from the main lane or thrown away and
  # says nothing about main. A cancelled retry leaves its failure unresolved.
  evicted = ->(run) { run["conclusion"] == "cancelled" && run["run_attempt"].to_i <= 1 }
  own, runs = latest.reject(&evicted).partition { |run| run["head_sha"] == sha }

  # This commit's own suite already failed: it has spoken.
  failed_own = own.find { |run| run["status"] == "completed" && run["conclusion"] != "success" }
  return [EXIT_WAIT, "own_suite_failed", { run: failed_own["id"] }] if failed_own

  # Main is red when either of two finished runs is: the newest commit's, since
  # each commit has its own lane and an older one can finish later; or the one
  # that finished last, since a re-run of an old run that fails now outranks a
  # newer run that passed earlier.
  finished = runs.select { |run| run["status"] == "completed" }
  return [EXIT_WAIT, "frozen_no_finished_run", {}] if finished.empty?
  newest = finished.max_by { |run| created_at(run) }
  red = [newest, finished.max_by { |run| updated_at(run) }].find { |run| run["conclusion"] != "success" }
  return [EXIT_WAIT, "frozen_main_red", { run: red["id"], run_sha: red["head_sha"].to_s[0, 12] }] if red

  pull = merged_pull(Array(payload["pulls"]), sha)
  return [EXIT_WAIT, "no_merged_pr", {}] unless pull

  ci_green = payload["ci_green"].to_s
  return [EXIT_WAIT, "pr_not_green", { pr: pull["number"], ci_green: ci_green }] unless ci_green == "success"

  [0, "early", { pr: pull["number"], main_run: newest["id"] }]
end

raw = ARGV.first

begin
  # API payloads carry commit messages; the runner's locale may not be UTF-8.
  payload = JSON.parse(raw ? File.read(raw, encoding: "UTF-8") : $stdin.read.force_encoding("UTF-8"))
rescue JSON::ParserError, Errno::ENOENT, EncodingError => e
  warn "deploy-before-main-suite gate could not run: #{e.message}"
  exit EXIT_OPERATIONAL
end

unless payload.is_a?(Hash)
  warn "deploy-before-main-suite gate could not run: expected a JSON object"
  exit EXIT_OPERATIONAL
end

begin
  code, reason, details = verdict(payload)
rescue StandardError => e
  warn "deploy-before-main-suite gate could not run: #{e.class}: #{e.message}"
  exit EXIT_OPERATIONAL
end
decision = code.zero? ? "early" : "wait"
fields = details.map { |key, value| "#{key}=#{value}" }.join(" ")
puts ["deploy-before-main-suite decision=#{decision} reason=#{reason} sha=#{payload['sha'].to_s[0, 12]}", fields].reject(&:empty?).join(" ")
exit code
