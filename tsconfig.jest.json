{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "jest",
      "node",
      "@testing-library/jest-dom"
    ],
    "module": "es2020",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowJs": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "app/javascript/**/*",
    "jest.setup.js"
  ]
}

