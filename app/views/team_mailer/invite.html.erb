<% accept_url = accept_settings_team_invitation_url(@team_invitation.external_id, email: @team_invitation.email) %>
<%= header_section(@subject) %>
<div>
  <p>You have been invited to join a team on Gumroad with the role of <%= @team_invitation.role.humanize %>.</p>
  <p>This is a team invitation, not a purchase receipt or a charge notice.</p>
  <p><strong>This invitation will expire in <%= (@team_invitation.expires_at.to_date - Time.current.to_date).to_i %> days.</strong></p>
  <p>If you are not expecting an invitation, please ignore this email.</p>
  <p><%= link_to "Accept invitation", accept_url, class: "button primary" %></p>
</div>
<div class="small muted">
  <p><strong>Button not working?</strong></p>
  <p class="break-word">Copy and paste this link into your browser: <%= link_to accept_url, accept_url, target: "_blank" %></p>
</div>
<div>
  <p>If this invitation expires, ask the account owner to send a new invitation.</p>
</div>
