<div>
  <p>
    <%= image_tag("email/wordmark_logo.png", alt: "Gumroad", style: "height: 22px; margin: 0 auto;", height: 22) %>
  </p>
</div>
<div style="background-color: #f4f4f0">
  <h2 style="text-align: center;"><%= @subject %></h2>
</div>
<div>
  <p>You have been invited to join a team on Gumroad with the role of <%= @team_invitation.role.humanize %>.</p>
  <p>This is a team invitation, not a purchase receipt or a charge notice.</p>
  <p>
    <strong>This invitation will expire in <%= (@team_invitation.expires_at.to_date - Time.current.to_date).to_i %> days.</strong>
  </p>
  <p>
    If you are not expecting an invitation, please ignore this email.
  </p>
  <p>
    <%= link_to "Accept invitation", accept_settings_team_invitation_url(@team_invitation.external_id, email: @team_invitation.email), class: "button primary" %>
  </p>
</div>
<div>
  <p>
    <strong>Button not working?</strong>
  </p>
  <p>
    Copy and paste this link into your browser: <%= link_to accept_settings_team_invitation_url(@team_invitation.external_id, email: @team_invitation.email), accept_settings_team_invitation_url(@team_invitation.external_id, email: @team_invitation.email), target: "_blank" %>
  </p>
</div>
<div>
  <p>If this invitation expires, ask the account owner to send a new invitation.</p>
</div>
