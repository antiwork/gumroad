<div class="hero">
  <img class="avatar large" src="<%= @user.avatar_url %>" alt="<%= @user_name %>" width="56" height="56">
  <h2><%= @subject %></h2>
  <p><%= @user_name %> joined the team at <%= @seller.username %> as <%= @team_membership.role.humanize %>.</p>
</div>
<div>
  <p><strong>Change their role?</strong></p>
  <p><%= link_to "Manage your team settings", settings_team_url, class: "button" %></p>
</div>
