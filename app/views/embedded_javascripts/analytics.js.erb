(function () {
  var script = document.currentScript;
  if (!script || !script.src) return;

  var id = "<%= j @product&.unique_permalink.to_s %>";
  var token = "<%= j @analytics_token.to_s %>";
  var origin;
  try {
    var src = new URL(script.src);
    origin = src.origin;
    if (!id) id = script.getAttribute("data-gumroad-product") || src.searchParams.get("id");
  } catch (e) {
    return;
  }
  if (!id || !token || !origin) return;

  var params = new URLSearchParams();
  params.set("analytics_token", token);

  var img = new Image();
  img.referrerPolicy = "origin";
  img.src = origin + "/links/" + encodeURIComponent(id) + "/increment_views.gif?" + params.toString();
})();
