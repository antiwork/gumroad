<%# The first star's alt carries the rating where aria-label does not reach: images off, and the text part. %>
<% label = pluralize(rating, "star") %>
<div class="stars" aria-label="<%= label %>">
  <% 5.times do |index| %>
    <%= image_tag(image_url(index < rating ? "email/solid-star.png" : "email/outline-star.png"), alt: index.zero? ? label : "", width: 20, height: 20) %>
  <% end %>
</div>
