<table class="product-checkout-cell" role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
  <tbody>
    <tr>
      <% product_name = product[:name] %>
      <% product_thumbnail_url = product[:thumbnail_url] %>
      <% product_url = product[:url] %>
      <td class="figure" width="128">
        <% if product_thumbnail_url.present? %>
          <%= link_to(image_tag(product_thumbnail_url, alt: product_name, width: 128), product_url, target: "_blank") %>
        <% end %>
      </td>
      <td class="section">
        <div class="content">
          <div class="section" title="<%= product_name %>">
            <h4>
              <%= link_to(product_name, product_url, target: "_blank") %>
            </h4>
          </div>
          <div class="section">
            <%= yield %>
          </div>
        </div>
      </td>
    </tr>
  </tbody>
</table>
