<%# locals: link: (the product), url_redirect:, button_style: nil (inline style carrying a seller's accent) %>
<%
  cta =
    if !url_redirect&.is_rental?
      [view_content_button_text(link), url_redirect_download_page_url(url_redirect.token)]
    elsif link.streamable?
      ["Watch", url_redirect_stream_page_url(url_redirect.token)]
    end
%>
<% if cta %>
  <p><%= link_to cta[0], cta[1], class: "button primary", style: local_assigns[:button_style] %></p>
<% end %>
