<div class="flex flex-col w-full  md:w-1/2 p-4">
  <div class="bg-white rounded-tr-2xl rounded-tl-2xl rounded-br-2xl p-6 lg:p-8 mb-4 relative border border-[#C6C6C6]">
    <%= image_tag "icons/quote.svg", alt: "Quote", class: "absolute top-6 left-6" %>
    <div class="pt-5 text-xl font-normal text-gray-900 leading-relaxed">
      <%= testimonial[:quote] %>
    </div>
  </div>
  <a href="<%= testimonial[:url] %>" rel="noopener noreferrer" class="flex items-center gap-4 hover:opacity-80 transition-opacity no-underline">
    <div class="w-12 h-12 rounded-full overflow-hidden">
      <%= image_tag testimonial[:avatar_path], alt: testimonial[:name] + " avatar", class: "h-12 w-12 object-cover" %>
    </div>
    <div class="flex flex-col">
      <div class="text-base font-bold text-gray-900 text-xl">
        <%= testimonial[:name] %>
      </div>
      <div class="text-base font-normal text-gray-500">
        <%= testimonial[:description] %>
      </div>
    </div>
  </a>
</div>
