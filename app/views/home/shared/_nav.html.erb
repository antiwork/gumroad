<%
  def nav_link(text, path, options = {})
    is_current = current_page?(path) || options[:current_page_predicate]&.call
    if options[:category] == "button"
      link_to text, path, class: "flex w-full items-center justify-center h-full #{
        if text == 'Dashboard'
          'lg:bg-[#262626] lg:text-white lg:hover:bg-pink dark:lg:bg-pink dark:lg:text-black dark:lg:hover:bg-white'
        elsif options[:context] != 'primary'
          'lg:border-l-black lg:bg-white lg:text-black lg:hover:bg-pink dark:lg:border-l-white/35 dark:lg:bg-[#262626] dark:lg:text-white'
        else
          'lg:bg-[#262626] lg:text-white lg:hover:bg-pink'
        end
      } border-black bg-[#262626] p-4 text-lg text-white no-underline transition-colors duration-200 hover:bg-pink hover:text-black lg:w-auto lg:border-l lg:py-2 lg:px-6 #{
        if options[:context] == 'primary' && text != 'Dashboard'
          'dark:lg:bg-pink dark:lg:text-black dark:lg:hover:bg-white'
        else
          'dark:lg:hover:bg-white dark:lg:hover:text-black'
        end
      }"
    else
      link_to text, path, class: "flex w-full items-center justify-center border #{
        is_current ? 'border-black' : 'border-transparent'
      } #{
        is_current ? 'lg:bg-[#262626] lg:text-white dark:lg:bg-white dark:lg:text-black' : 'lg:bg-transparent lg:text-black dark:lg:text-white'
      } bg-[#262626] p-4 text-lg text-white no-underline transition-all duration-200 hover:border-black lg:w-auto lg:rounded-full lg:py-2 lg:px-4 dark:text-white lg:dark:hover:border-white/35 whitespace-nowrap"
    end
  end

  def logo_link(options = {})
    link_to "/", class: options[:class] do
      image_tag "logo.svg",
        loading: "lazy",
        alt: "",
        class: "#{options[:image_class]} dark:invert"
    end
  end

  def toggle_button
    content_tag :div, class: "flex items-center lg:hidden" do
      content_tag :button,
        class: "relative flex h-8 w-8 flex-col items-center justify-center focus:outline-hidden",
        data: { toggle: "mobile-menu" } do
          content_tag(:div, "",
            class: "mb-1 h-0.5 w-8 origin-center bg-[#262626] transition-transform duration-200 dark:bg-white",
            data: { menu_line: "1" }
          ) +
          content_tag(:div, "",
            class: "mt-1 h-0.5 w-8 origin-center bg-[#262626] transition-transform duration-200 dark:bg-white",
            data: { menu_line: "2" }
          )
      end
    end
  end

  def nav_links
    content_tag :div, class: "flex flex-col justify-center items-center lg:flex-row lg:gap-1 lg:px-6" do
      nav_link("Khám phá", discover_path) +
      nav_link("Bài viết", gumroad_blog_root_path, {current_page_predicate: -> { request.path.start_with?(gumroad_blog_root_path) }}) +
      nav_link("Bảng giá", pricing_path) +
      nav_link("Tính năng", features_path) +
      nav_link("Giới thiệu", about_path, {current_page_predicate: -> { current_page?(root_path) }})
    end
  end

  def auth_links
    content_tag :div, class: "flex flex-col lg:flex-row lg:h-full" do
      if signed_in?
        nav_link("Giới thiệu", dashboard_url(host: DOMAIN), category: "button", context: "primary")
      else
        nav_link("Đăng nhập", new_user_session_path, category: "button") +
        nav_link("Bắt đầu bán hàng", new_user_registration_path, category: "button", context: "primary")
      end
    end
  end
%>

<div class="justify-between bg-white border-b border-black top-0 left-0 right-0 z-50 pr-4 pl-4 h-20 sticky flex lg:pl-8 lg:pr-0 dark:bg-[#262626] dark:border-b-white/35">
  <div class="flex items-center gap-2">
    <%= logo_link(class: "flex items-center", image_class: "h-7 lg:h-8") %>
  </div>

  <div class="override hidden lg:flex lg:items-center">
    <%= nav_links %>
    <%= auth_links %>
  </div>

  <%= toggle_button %>
</div>
<div class="override hidden justify-between border-b border-black flex-col top-20 left-0 right-0 z-50 fixed bg-[#262626] dark:border-white/35" id="mobile-menu">
  <%= nav_links %>
  <%= auth_links %>
</div>
