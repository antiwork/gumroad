<header class="grid override grid-cols-1 bg-[#f0f0f0]">
  <div data-hero-parallax-container class="relative flex items-center justify-center  bg-gray-100 px-8 py-40 lg:px-[8vw] md:py-[12rem]">
    <div class="flex flex-col max-w-screen-lg items-center gap-6 text-center z-10">
      <h1 class="leading-none text-6xl md:text-7xl lg:text-8xl">Go from<br class="sm:hidden"> <span class="whitespace-nowrap">0 to $1</span></h1>
      <div class="text-xl max-w-md lg:text-2xl lg:max-w-3xl">Anyone can earn their first dollar online. Just start with what you know, see what sticks, and get paid. It's that easy.</div>
      <div class="mt-2 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 w-full max-w-[384px] sm:max-w-none sm:w-auto mx-auto">
        <div class="w-full sm:w-auto [&>div]:!block">
          <%= render "home/shared/button", text: "Start selling", url: new_user_registration_path %>
        </div>
        <form action="<%= discover_path %>" method="get" class="relative w-full sm:w-auto">
          <label for="marketplace-search" class="sr-only">Search marketplace</label>
          <input
            id="marketplace-search"
            type="text"
            name="query"
            placeholder="Search marketplace ..."
            class="px-4 pr-12 border !border-[#c6c6c6] rounded-md focus:outline-none focus:ring-1 focus:ring-black focus:border-[#c6c6c6] w-full sm:w-64 !text-xl !h-14 lg:!h-16"
          />
          <button
            type="submit"
            aria-label="Search"
            class="absolute mr-3 right-0 top-1/2 -translate-y-[55%]"
          >
            <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </button>
        </form>
      </div>
      <div class="text-base">
        Contribute or fork on <a href="https://github.com/antiwork/gumroad" target="_blank" rel="noopener noreferrer" class="underline hover:text-black inline-flex items-center gap-1 ml-1">
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          GitHub
        </a>
      </div>
    </div>
    <div class="absolute inset-0 pointer-events-none overflow-visible parallax-up">
      <div class="hero-coin absolute z-[1] w-[8rem] invisible md:visible sm:w-[8rem] sm:top-[20rem] sm:right-[-3rem] md:w-[10rem] md:top-[54rem] md:right-[4rem] lg:w-[11rem] lg:top-[55rem]" data-parallax-intensity="0.03" data-scroll-intensity="-0.20">
        <%= image_tag "about/coin-1.svg", loading: "lazy", alt: "Decorative coin 1", class: "w-full h-auto" %>
      </div>
      <div class="hero-coin absolute z-[1] w-[10rem] top-[28rem] left-[-12vw] sm:left-[-7vw] md:left-[3vw] md:w-[11rem] md:top-[25rem] md:left-[8vw]" data-parallax-intensity="-0.02" data-scroll-intensity="-0.15">
        <%= image_tag "about/coin-2.svg", loading: "lazy", alt: "Decorative coin 2", class: "w-full h-auto" %>
      </div>
      <div class="hero-coin absolute z-[1] w-[9rem] right-[-3vw] top-[-7rem] invisible sm:visible md:w-[8rem] md:top-[26rem] md:right-[6vw]" data-parallax-intensity="0.05" data-scroll-intensity="-0.18">
        <%= image_tag "about/coin-3.svg", loading: "lazy", alt: "Decorative coin 3", class: "w-full h-auto" %>
      </div>
      <div class="hero-coin absolute z-[1] w-[9rem] top-[53rem] right-[-14vw] sm:top-[42rem] sm:right-[-5rem] md:w-[11rem] md:top-[44rem] md:right-[-5rem] lg:w-[12rem] lg:top-[42rem] lg:right-[-7rem]" data-parallax-intensity="-0.035" data-scroll-intensity="-0.16">
        <%= image_tag "about/coin-4.svg", loading: "lazy", alt: "Decorative Coin 4", class: "w-full h-auto" %>
      </div>
      <div class="hero-coin absolute z-[1] w-[10rem] left-[-2rem] top-[53rem] sm:w-[10rem] sm:top-[50rem] sm:left-[3rem] md:w-[14rem] md:top-[45rem] md:left-[-6rem] lg:w-[16rem] lg:left-[-3rem]" data-parallax-intensity="0.04" data-scroll-intensity="-0.17">
        <%= image_tag "about/coin-5.svg", loading: "lazy", alt: "Decorative Coin 5", class: "w-full h-auto" %>
      </div>
    </div>
  </div>
</header>

<section class="py-4 bg-[#f0f0f0]">
  <div class="container mx-auto ">
    <div class="flex flex-col xl:flex-row gap-6 lg:gap-8 items-start">
      <div class="w-full xl:w-[70%] bg-white rounded-2xl p-4 sm:p-6 md:p-8 border border-[#c6c6c6] sm:h-auto md:h-[500px]">
        <div class="flex flex-col md:flex-row items-center justify-between">
          <div class="flex flex-col justify-between w-full md:w-auto">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium mb-4  sm:pb-[2rem] md:pb-[8rem] lg:pb-[10rem] xl:pb-[12rem]">Sell <br class="hidden sm:block" /> anything.</h2>
            <p class="text-base sm:text-lg md:text-xl">Video lessons. Monthly <br class="hidden md:block" /> subscriptions. Whatever! Gumroad <br class="hidden sm:block" /> was created to help you experiment <br class="hidden md:block" /> with all kinds of ideas and formats.</p>
          </div>
          <div class="md:mr-[-60px] md:mt-[-95px] md:mb-[-95px] w-auto  md:w-[510px]">
            <%= image_tag "about/sell-anything.svg", alt: "Sell anything illustration", class: "h-auto xl:h-[625px]" %>
          </div>
        </div>
      </div>
      <div class="w-full xl:w-[30%] bg-white rounded-2xl border border-[#c6c6c6] pr-0 sm:pr-4 md:pr-6 sm:h-auto md:h-[500px]">
        <div class="px-4 sm:px-6 md:px-8 pt-4 sm:pt-6 ">
          <h2 class="text-3xl sm:text-4xl font-medium mb-4">Make your <br class="hidden sm:block" /> own road.</h2>
          <p class="text-base sm:text-lg md:text-xl pb-4 sm:pb-6 ">Whether you need more<br class="hidden md:block" /> balance, flexibility, or just a<br class="hidden md:block" /> different gig, we make it easy<br class="hidden md:block" /> to chart a new path.</p>
        </div>
        <div class="w-full">
          <%= image_tag "about/total-sales.svg", alt: "Total sales illustration", class: "h-auto rounded-bl-2xl" %>
        </div>
      </div>
    </div>
  </div>
</section>
<section class=" py-16 lg:py-24 bg-[#f0f0f0]">
  <div class="container mx-auto ">
    <div class="flex flex-col xl:flex-row gap-6 lg:gap-8 items-start">
      <div class="w-full xl:w-[30%] bg-white rounded-2xl border border-[#c6c6c6] h-auto xl:h-[500px]">
        <div class="p-4 sm:p-6 md:p-8 h-full flex flex-col justify-between">
          <h2 class="text-3xl sm:text-4xl font-medium mb-4">Sell to <br class="hidden xl:block" /> anyone.</h2>
          <ul class="p-0 text-base sm:text-lg md:text-xl">
              <li class="flex items-center gap-x-3">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0">
                  <circle cx="12" cy="12" r="11" fill="#FF90E8" stroke="black" stroke-width="2"/>
                  <path d="M7 12.5L10.5 16L17.5 9" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Build a loyal following with email newsletters and automated workflows.</span>
              </li>
              <li class="flex items-center gap-x-3">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0">
                  <circle cx="12" cy="12" r="11" fill="#FF90E8" stroke="black" stroke-width="2"/>
                  <path d="M7 12.5L10.5 16L17.5 9" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Let your customers pay in their own currency.</span>
              </li>
              <li class="flex items-center gap-x-3">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="flex-shrink-0">
                  <circle cx="12" cy="12" r="11" fill="#FF90E8" stroke="black" stroke-width="2"/>
                  <path d="M7 12.5L10.5 16L17.5 9" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Choose between one-time, recurring, or fixed-length payments in your currency of choice.</span>
              </li>
            </ul>
        </div>
      </div>
      <div class="w-full xl:w-[70%] bg-white rounded-2xl p-4 sm:p-6 md:p-8 border border-[#c6c6c6] sm:h-auto md:h-[500px]">
        <div class="flex flex-col md:flex-row items-center justify-between">
          <div class="flex flex-col justify-between w-full md:w-[36%]">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium mb-4 pb-[2rem] xl:pb-[9rem]">Sell <br class="hidden sm:block" /> anywhere.</h2>
            <p class="text-base sm:text-lg md:text-xl sm:pb-[2rem]">Create and customize your storefront with our all-in-one platform or choose to use your personal site instead. Seamlessly connect your Gumroad account to thousands of apps in your current stack.</p>
          </div>
          <div class="md:mr-[-150px]  w-auto  md:w-[500px]">
            <%= image_tag "about/gumroad-profile.svg", alt: "Sell anywhere illustration", class: "h-auto " %>
          </div>
        </div>
      </div>


    </div>
  </div>
</section>

<section class=" py-16 lg:py-24 bg-[#f0f0f0]">
  <div class="container mx-auto ">
    <div class="flex flex-col md:flex-row gap-6 lg:gap-8 items-start">
          <%= image_tag "about/building.svg", alt: "Building a company illustration", class: "w-full" %>
          <%= image_tag "about/selling.svg", alt: "Selling a sideproject illustration", class: "w-full" %>
    </div>
  </div>
</section>

<div class="relative py-24 lg:py-32 bg-[#f0f0f0]">
  <div class="px-8 lg:px-[4vw]">
    <div class="max-w-4xl mx-auto text-center text-4xl mb-20 lg:mb-24 lg:leading-tight lg:text-5xl">
      You know all those great ideas you have?
    </div>
  </div>
  <div class="relative max-w-6xl mx-auto mb-12 h-80 bg-orange p-8 border-y border-[#c6c6c6] lg:border lg:rounded-full">
    <div id="lottie-animation" class="absolute w-56 h-56 z-20 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 lg:top-20 lg:w-80 lg:h-80">
      <lottie-player
        src="<%= asset_path("about/gumhead.json") %>"
        speed="1"
        loop
        autoplay>
      </lottie-player>
