<%= header_section "#{@comment.author_name} commented on #{@comment.commentable.name}" %>

<div class="card">
  <h4><%= @comment.author_name %></h4>
  <p class="muted small"><%= l(@comment.created_at, format: "%B %-d, %Y %-I:%M%p") %></p>
  <p class="preserve-lines"><%= raw Rinku.auto_link(strip_tags(@comment.content), :all, %(target="_blank" rel="noopener noreferrer nofollow")) %></p>
</div>

<p><%= link_to "View comment", custom_domain_view_post_url(slug: @comment.commentable.slug, host: @comment.commentable.seller.subdomain_with_protocol), class: "button primary", target: "_blank" %></p>

<p class="muted small">To stop receiving comment notifications, please <%= link_to "change your notification settings", settings_main_url(anchor: "notifications"), target: "_blank" %>.</p>
