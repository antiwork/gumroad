<%= header_section("Ready-made bundles for you!") %>
<div>
  <p>We've put together some awesome bundles of your top products - they're ready and waiting for you. Gumroad creators have already made over $300,000 selling bundles. Launch your bundles now with just a few clicks!</p>
</div>

<% @bundles.each do |bundle| %>
  <div class="card bundle">
    <% price = safe_join([tag.s(MoneyFormatter.format(bundle[:price], @currency_type, no_cents_if_whole: true, symbol: true)), MoneyFormatter.format(bundle[:discounted_price], @currency_type, no_cents_if_whole: true, symbol: true)], " ") %>
    <%= render("shared/mailers/product", product: { name: Product::BundlesMarketing::BUNDLE_NAMES[bundle[:type]], thumbnail_url: image_url("bundles_marketing/#{bundle[:type]}.png"), thumbnail_alt: "" }, price:) %>
    <p>This bundle contains...</p>
    <ul>
      <% bundle[:products].each do |product| %>
        <li><%= link_to product[:name], product[:url] %></li>
      <% end %>
    </ul>
    <p><%= link_to "Edit and launch", create_from_email_bundles_url(type: bundle[:type], price: bundle[:discounted_price], products: bundle[:products].map { _1[:id] }), class: "button primary" %></p>
  </div>
<% end %>
