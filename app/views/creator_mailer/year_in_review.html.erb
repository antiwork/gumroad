<% formatted_total_amount = Money.new(@analytics_data[:total_amount_cents] * get_rate(@seller.currency_type).to_f, @seller.currency_type.to_sym).format(no_cents_if_whole: true, symbol: true) %>
<% rank = @analytics_data[:creator_rank] %>

<div class="hero">
  <% if rank.present? %>
    <%= image_tag(image_url("email/badge_year_#{@year}.png"), alt: @year, width: 132, height: 112) %>
  <% end %>
  <h2>Your year on Gumroad in review</h2>
  <% if rank.present? %>
    <p>You ranked #<%= rank %> among all creators</p>
  <% end %>
</div>

<table class="details">
  <tr>
    <th>Sales</th>
    <td><strong><%= number_with_delimiter(@analytics_data[:total_sales_count]) %></strong></td>
  </tr>
  <tr>
    <th>Views</th>
    <td><strong><%= number_with_delimiter(@analytics_data[:total_views_count]) %></strong></td>
  </tr>
  <tr>
    <th>Unique customers</th>
    <td><strong><%= number_with_delimiter(@analytics_data[:total_unique_customers_count]) %></strong></td>
  </tr>
  <tr>
    <th>Products sold</th>
    <td><strong><%= number_with_delimiter(@analytics_data[:total_products_sold_count]) %></strong></td>
  </tr>
</table>

<% if @analytics_data[:top_selling_products].present? %>
  <div>
    <h3>Your top <%= @analytics_data[:top_selling_products].count > 1 ? "#{@analytics_data[:top_selling_products].count} products" : "product" %></h3>
    <% @analytics_data[:top_selling_products].each do |product| %>
      <% views, sales, total = product[:stats] %>
      <% byline = capture do %>
        <span class="nowrap"><%= number_to_si(views) %> <%= "view".pluralize(views) %></span>
        ·
        <span class="nowrap"><%= number_to_si(sales) %> <%= "sale".pluralize(sales) %></span>
        ·
        <span class="nowrap"><%= total.abs < 1 ? Money.from_amount(total, Currency::USD).format(no_cents_if_whole: true) : "$#{number_to_si(total)}" %></span>
      <% end %>
      <%= render("shared/mailers/product", product:, byline:) %>
    <% end %>
  </div>
<% end %>

<div>
  <h3>You sold products in <%= pluralize(@analytics_data[:total_countries_with_sales_count], "country") %></h3>
  <table class="list">
    <thead>
      <tr>
        <th>Country</th>
        <th class="number">Views</th>
        <th class="number">Sales</th>
        <th class="number">Total</th>
      </tr>
    </thead>
    <tbody>
      <% @analytics_data[:by_country].each do |(country, (views, sales, total))| %>
        <% money = Money.new(total * 100 * get_rate(@seller.currency_type).to_f, @seller.currency_type.to_sym) %>
        <tr>
          <td><%= country %></td>
          <td class="number"><%= number_to_si(views) %></td>
          <td class="number"><%= number_to_si(sales) %></td>
          <td class="number"><%= money.dollars.abs < 1 ? money.format(no_cents_if_whole: true, symbol: true) : "#{money.symbol}#{number_to_si(money.dollars)}" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="hero">
  <p class="eyebrow">You earned a total of</p>
  <p class="figure"><%= formatted_total_amount %></p>
</div>

<% if @analytics_data[:gpt_buy_list].present? %>
  <div class="card">
    <table class="chat" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td class="chat-avatar" width="36">
          <%= image_tag(image_url("email/gpt3_gumroad.png"), alt: "Gumroad", class: "avatar", width: 24, height: 24) %>
        </td>
        <td class="chat-message">
          <%= "Hey, can you suggest some things I could buy with my Gumroad earnings of #{formatted_total_amount}?" %>
        </td>
      </tr>
      <tr>
        <td class="chat-avatar" width="36">
          <%= image_tag(image_url("email/ai-icon.png"), alt: "AI", class: "avatar", width: 24, height: 24) %>
        </td>
        <td class="chat-message">
          <ul>
            <% @analytics_data[:gpt_buy_list].each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        </td>
      </tr>
    </table>
  </div>
<% end %>

<% if @seller.from_us? %>
  <div class="callout">
    <% if @seller.eligible_for_1099?(@year) %>
      <p>Your 1099 form is available for download on your <%= link_to "Gumroad Tax Center", tax_center_url %> page.</p>
    <% else %>
      <p>You do not qualify for a 1099 this year.</p>
    <% end %>
  </div>
<% end %>

<% if @payout_csv_url.present? %>
  <div>
    <h3>Here's your financial report for <%= @year %>!</h3>
    <p>Please click this <%= link_to "link", @payout_csv_url %> to download the payout summary.</p>
  </div>
<% end %>
