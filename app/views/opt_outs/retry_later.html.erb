<main class="grid divide-y divide-border bg-background border border-border rounded mx-auto my-4 h-min max-w-md w-[calc(100%-2rem)]">
  <header class="flex flex-col gap-4 p-4 text-center">
    <h2>We couldn't finish unsubscribing you.</h2>
    <p>Something else was updating your subscription at the same time. Please try again in a minute.</p>
  </header>
  <div class="flex flex-col gap-4 p-4">
    <%= link_to "Try again", request.fullpath, class: "inline-flex items-center justify-center gap-2 cursor-pointer border border-border rounded font-[inherit] no-underline transition-transform hover:-translate-1 hover:shadow active:translate-0 active:shadow-none disabled:opacity-30 disabled:hover:translate-0 disabled:hover:shadow-none px-4 py-3 text-base leading-snug bg-primary text-primary-foreground hover:bg-accent-with-text hover:text-accent-foreground w-full" %>
  </div>
</main>
<% content_for :footer do %>
  <%= default_footer_content %>
<% end %>
