<%# brand: nil for Gumroad's own mark, or { name:, url:, logo_url: } to put a seller's name on a
    buyer-facing email. %>
<div class="header">
  <% if brand.present? %>
    <a class="brand" href="<%= brand[:url] %>" target="_blank">
      <% if brand[:logo_url].present? %>
        <img class="avatar brand-logo" src="<%= brand[:logo_url] %>" alt="" width="40" height="40">
      <% end %>
      <span class="brand-name"><%= brand[:name] %></span>
    </a>
  <% else %>
    <a class="wordmark" href="<%= root_url %>">
      <%# The black mark with a halo in the page colour. The halo cannot be seen on the page. Where
          a client inverts the page for dark mode and leaves images alone (Gmail on Android), the
          halo is what keeps the mark readable. The file is taller than the mark by the halo. %>
      <img src="<%= image_url("email/wordmark_logo_on_page.png") %>" alt="Gumroad" width="123" height="20">
    </a>
  <% end %>
</div>
