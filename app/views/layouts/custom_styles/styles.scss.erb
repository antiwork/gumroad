@if "<%= font %>" != "ABC Favorit" {
  @import url(<%= font_css_source %>);
}

@function split-color($color) {
  @return red($color) green($color) blue($color);
}

:root {
  // Keep --accent as the seller's saved highlight colour so decorative fills, borders, and
  // accent-coloured text do not change. Only surfaces that put content on the accent opt into
  // --accent-with-text and its matching --contrast-accent. Checkout additionally overrides
  // --indicator after this blob, so focus and selection rings there clear a contrast floor.
  --accent: #{split-color(<%= highlight_color %>)};
  --accent-with-text: #{split-color(<%= accent_color_for_text_areas %>)};
  --contrast-accent: #{split-color(<%= text_color_on_highlight %>)};
  --font-family: <%= font_family %>;
  --color: #{split-color(<%= text_color_on_background %>)};
    --primary: var(--color);
  --contrast-primary: #{split-color(<%= text_color_on_primary %>)};
  --filled: #{split-color(<%= background_color %>)};
  --contrast-filled: var(--color);
  --danger: #{split-color(<%= danger_color %>)};
  --contrast-danger: #{split-color(<%= text_color_on_danger %>)};
  --body-bg: <%= background_color %>;
  --active-bg: rgb(var(--color) / var(--gray-1));
  --border-alpha: 1;
}

body {
  background-color: <%= background_color %>;
  color: <%= text_color_on_background %>;
  font-family: <%= font_family %>;
}
