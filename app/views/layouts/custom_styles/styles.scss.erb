@if "<%= font %>" != "ABC Favorit" {
  @import url(<%= Addressable::URI::encode("https://fonts.googleapis.com/css2?family=#{font}:wght@400;600&display=swap") %>);
}

@function split-color($color) {
  @return red($color) green($color) blue($color);
}

:root {
  // --accent is what fills accent areas that carry text (the pay button, the offer banner price),
  // paired with --contrast-accent for that text. It is the seller's saved highlight colour unless
  // that colour could not carry black or white text at the 4.5:1 WCAG AA minimum, in which case its
  // brightness is nudged by the smallest amount that clears the floor. See ContrastColor.
  --accent: #{split-color(<%= accent_color_for_text_areas %>)};
  --contrast-accent: #{split-color(<%= text_color_on_highlight %>)};
  // --accent-plain is the seller's saved highlight colour, untouched, for accent areas with no text
  // on them: focus outlines, borders, tinted panels, decorative fills.
  --accent-plain: #{split-color(<%= highlight_color %>)};
  --font-family: <%= font_family %>;
  --color: #{split-color(<%= text_color_on_background %>)};
    --primary: var(--color);
  --contrast-primary: #{split-color(<%= text_color_on_primary %>)};
  --filled: #{split-color(<%= background_color %>)};
  --contrast-filled: var(--color);
  --body-bg: <%= background_color %>;
  --active-bg: rgb(var(--color) / var(--gray-1));
  --border-alpha: 1;
}

body {
  background-color: <%= background_color %>;
  color: <%= text_color_on_background %>;
  font-family: <%= font_family %>;
}
