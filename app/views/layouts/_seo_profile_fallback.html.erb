<%# noscript is a raw-text element, so an unescaped closing tag in the name, bio or a product name
    ends it early: every value is plain escaped output, never html_safe. The links are the product
    cards the profile itself renders, so this repeats the page rather than serving a crawler only. %>
<noscript>
  <article>
    <h1><%= @seo_profile_fallback[:name] %></h1>
    <% if @seo_profile_fallback[:bio].present? %>
      <p><%= @seo_profile_fallback[:bio] %></p>
    <% end %>
    <% if @seo_profile_fallback[:products].present? %>
      <nav aria-label="Products">
        <ul>
          <% @seo_profile_fallback[:products].each do |product| %>
            <li><a href="<%= product[:href] %>"><%= product[:label] %></a></li>
          <% end %>
        </ul>
      </nav>
    <% end %>
  </article>
</noscript>
