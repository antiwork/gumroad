<div>
  <p><strong>New Help Center contact form submission</strong></p>
  <p>
    Category: <%= @category %>
    <br>
    From: <%= @email %>
    <% if @user.present? %>
      <br>
      Account: <%= @user.email %> (<%= @user.name.presence || "no name set" %>, id: <%= @user.id %>)
    <% end %>
    <% if @referrer_path.present? %>
      <br>
      Submitted from: <%= @referrer_path %>
    <% end %>
    <% if @attachment_filenames.present? %>
      <br>
      Attachments: <%= @attachment_filenames.size %> (<%= @attachment_filenames.join(", ") %>)
    <% end %>
  </p>
</div>
<div class="card">
  <p class="preserve-lines"><%= @message %></p>
</div>
