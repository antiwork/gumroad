<%= header_section(@subject) %>
<div>
  <% if @waitlist_product %>
    <p>Click the button below to confirm you want to hear when <%= @waitlist_product.name %> launches:</p>
  <% else %>
    <p>Click the button below to confirm your subscription to <%= @followed_username %>:</p>
  <% end %>
  <p>
    <%= link_to "Confirm", @confirm_follow_url, class: "button primary" %>
  </p>
  <p>Or you can click here: <%= link_to @confirm_follow_url, @confirm_follow_url %></p>
</div>
