<%= header_section(@subject) %>

<div>
  <% if @source.present? %>
    <p><%= @source %></p>
  <% end %>

  <% @message_lines.each do |line| %>
    <p><%= auto_link(line) %></p>
  <% end %>

  <% @attachments.each do |attachment| %>
    <p>
      <% if attachment[:title].present? && attachment[:url].present? %>
        <strong><%= link_to attachment[:title], attachment[:url] %></strong>
      <% elsif attachment[:title].present? %>
        <strong><%= attachment[:title] %></strong>
      <% elsif attachment[:url].present? %>
        <%= link_to attachment[:url], attachment[:url] %>
      <% end %>

      <% if attachment[:text].present? && attachment[:text] != attachment[:url] %>
        <br><%= attachment[:text] %>
      <% end %>
    </p>
  <% end %>
</div>
