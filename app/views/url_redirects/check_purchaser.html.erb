<%# TODO: When migrating to React/Inertia, use the Stack component instead of these Tailwind classes %>
<% stack_classes = "grid bg-filled border border-border rounded stack-component [&>*]:flex [&>*]:flex-wrap [&>*]:items-center [&>*]:p-4 [&>*]:gap-4 [&>*]:justify-between [&>*:not(:first-child)]:border-t [&>*:not(:first-child)]:border-border [&>*>:first-child]:flex-grow [&>*>:first-child:where(.button,fieldset)]:flex-[0_1_0%] [&>*>:where(.button,fieldset)+:where(.button,fieldset)]:flex-1 [&>*_h4]:font-bold [&>*_h5]:font-bold [&>*_h6]:font-bold [&>details]:block [&>details_summary]:grid [&>details_summary]:grid-flow-col [&>details_summary]:grid-cols-[1fr_auto] [&>details_summary::before]:col-start-2 h-min m-4 mx-auto max-w-[28rem] w-[calc(100%-2*1rem)] [&>header]:text-center [&>footer]:text-center [&>*]:flex-col [&>*]:items-start" %>

<main class="<%= stack_classes %> single-page-form horizontal-form">
  <header>
    <h2>This product belongs to a different Gumroad account.</h2>
    <p>Would you like to change this purchase so that it belongs to you?</p>
  </header>
  <div class="mini-rule legacy-only"></div>
  <%= form_tag(url_redirect_change_purchaser_url(@url_redirect.token), method: "post") do %>
    <%= hidden_field_tag :next, params[:next] %>
    <%= label_tag :email, "Email address used to purchase this product:", class: "form-label" %>
    <%= email_field_tag :email, nil, placeholder: "Email address", required: true %>
    <%= button_tag "Change purchase", type: "submit", class: "button primary" %>
  <% end %>
</main>
<% content_for :footer do %>
  <%= default_footer_content %>
<% end %>
