<% charge_info = @receipt_presenter.charge_info %>
<%= header_section("You've received a gift!") %>

<div>
  <p>Hi! <% if @chargeable.try(:gifter_hidden_from_recipient?) %>Someone<% else %><%= mail_to(@chargeable.gifter_email) %><% end %> bought this as a gift for you. We hope you like it!</p>

  <% if @chargeable.gift_note.present? %>
    <div class="callout preserve-lines" role="status"><%= @chargeable.gift_note %></div>
  <% end %>
</div>

<div>
  <% @receipt_presenter.items_infos.each do |item_info| %>
    <div class="card">
      <%= render("customer_mailer/receipt/item", item_info: item_info) %>
    </div>
  <% end %>

  <% if @receipt_presenter.giftee_manage_subscription.note.present? %>
    <p><%= @receipt_presenter.giftee_manage_subscription.note %></p>
  <% end %>

  <% if charge_info.product_questions_note.present? %>
    <p><%= charge_info.product_questions_note %></p>
  <% end %>
</div>

<%= render("customer_mailer/receipt/sections/shipping", receipt_presenter: @receipt_presenter) %>

<table class="details">
  <tr>
    <th>Order ID:</th>
    <td><%= charge_info.order_id %></td>
  </tr>
  <tr>
    <th>Order date:</th>
    <td><%= charge_info.formatted_created_at %></td>
  </tr>
</table>
