<%# locals: receipt_presenter:, chargeable:, order_receipt_url: nil, button_style: nil (inline style for the download button) %>
<% button_style = local_assigns[:button_style] %>
<% if chargeable.is_recurring_subscription_charge %>
  <%= render("customer_mailer/receipt/sections/header", receipt_presenter: receipt_presenter) %>
  <%= render("customer_mailer/receipt/sections/payment", receipt_presenter: receipt_presenter) %>
  <%= render("customer_mailer/receipt/sections/items", receipt_presenter: receipt_presenter, button_style: button_style) %>
  <%= render("customer_mailer/receipt/sections/shipping", receipt_presenter: receipt_presenter) %>
  <%= render("customer_mailer/receipt/sections/recommended_products", receipt_presenter: receipt_presenter) %>
<% else %>
  <%= render("customer_mailer/receipt/sections/header", receipt_presenter: receipt_presenter, order_receipt_url: local_assigns[:order_receipt_url]) %>
  <%= render("customer_mailer/receipt/sections/items", receipt_presenter: receipt_presenter, button_style: button_style) %>
  <%= render("customer_mailer/receipt/sections/shipping", receipt_presenter: receipt_presenter) %>
  <%= render("customer_mailer/receipt/sections/payment", receipt_presenter: receipt_presenter) %>
  <%= render("customer_mailer/receipt/sections/recommended_products", receipt_presenter: receipt_presenter) %>
<% end %>
