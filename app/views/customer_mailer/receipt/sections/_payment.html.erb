<% payment_info = receipt_presenter.payment_info %>
<% if payment_info.present? %>
  <div>
    <h3><%= payment_info.title %></h3>
    <% payment_info.notes.each do |note| %>
      <p><%= note %></p>
    <% end %>
    <%= render("customer_mailer/receipt/attributes", attributes: payment_info.today_payment_attributes + payment_info.upcoming_payment_attributes + [payment_info.payment_method_attribute].compact, headings: true) %>
  </div>
<% end %>
