<% recommended_products_info = receipt_presenter.recommended_products_info %>
<% if recommended_products_info.present? %>
  <% products = recommended_products_info.products %>
  <% product_rows = products.each_slice(2).to_a %>
  <div>
    <h3><%= recommended_products_info.title %></h3>
    <table class="reset two-product-card-table">
      <tbody>
        <% product_rows.each_with_index do |row_products, row_index| %>
          <tr class="<%= "product-card-row-with-gap" if row_index < product_rows.size - 1 %>">
            <% row_products.each_with_index do |product, column_index| %>
              <% product_index = row_index * 2 + column_index %>
              <td class="<%= "product-card-cell-with-gap" if product_index < products.size - 1 %>">
                <table class="reset product-card-table" align="center" role="presentation">
                  <tbody>
                    <tr>
                      <td>
                        <%= render("customer_mailer/receipt/product_card", product: product) %>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
