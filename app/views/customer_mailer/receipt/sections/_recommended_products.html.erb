<% recommended_products_info = receipt_presenter.recommended_products_info %>
<% if recommended_products_info.present? %>
  <div>
    <h3><%= recommended_products_info.title %></h3>
    <%# One table per row, so the gap between rows is a margin rather than a spacer cell. %>
    <% recommended_products_info.products.each_slice(2) do |row_products| %>
      <table class="product-grid" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <% row_products.each do |product| %>
            <td width="50%">
              <%= render("customer_mailer/receipt/product_card", product: product) %>
            </td>
          <% end %>
          <% if row_products.one? %>
            <td width="50%"></td>
          <% end %>
        </tr>
      </table>
    <% end %>
  </div>
<% end %>
