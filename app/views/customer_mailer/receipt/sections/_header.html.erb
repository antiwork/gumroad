<% charge_info = receipt_presenter.charge_info %>
<div>
  <table class="details order-meta">
    <tr>
      <th class="nowrap">Order ID:</th>
      <td><%= charge_info.order_id %></td>
    </tr>
    <tr>
      <th class="nowrap">Order date:</th>
      <td><%= charge_info.formatted_created_at %></td>
    </tr>
    <% if !charge_info.free? && charge_info.formatted_total_transaction_amount.present? %>
      <tr>
        <th class="nowrap">Total:</th>
        <td><strong><%= charge_info.formatted_total_transaction_amount %></strong></td>
      </tr>
    <% end %>
  </table>
  <% if local_assigns[:order_receipt_url] %>
    <p><%= link_to "View every item in this order", order_receipt_url %></p>
  <% end %>
</div>
