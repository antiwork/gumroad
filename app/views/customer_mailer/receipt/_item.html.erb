<%# locals: item_info:, button_style: nil %>
<% item_props = item_info.props %>
<% seller = item_props.dig(:product, :seller) %>
<% byline = capture do %>
  <%= link_to(image_tag(seller[:avatar_url], alt: "Avatar of #{seller[:name]}", class: "avatar", width: 24, height: 24), seller[:profile_url], target: "_blank") %>
  <%= link_to(seller[:name], seller[:profile_url], target: "_blank") %>
<% end %>
<%= render("shared/mailers/product", product: item_props[:product], byline:) %>

<% details = capture do %>
  <% item_props[:notes].each do |note| %>
    <p><strong><%= note %></strong></p>
  <% end %>

  <% if item_props[:custom_receipt_note].present? %>
    <%= simple_format(item_props[:custom_receipt_note]) %>
  <% end %>

  <% if item_props[:license_key].present? %>
    <div class="license-key">
      <h4>License key</h4>
      <div class="code"><%= item_props[:license_key] %></div>
    </div>
  <% end %>

  <% if item_props[:show_download_button] %>
    <% purchase = item_info.purchase %>
    <% url_redirect = purchase.is_commission_completion_purchase? ? purchase.commission.deposit_purchase.url_redirect : purchase.url_redirect %>
    <%= render("shared/download_button", link: item_info.product, url_redirect: url_redirect, button_style: local_assigns[:button_style]) %>
  <% end %>

  <%= render("customer_mailer/receipt/attributes", attributes: item_props[:gift_attributes]) %>
  <%= render("customer_mailer/receipt/attributes", attributes: item_props[:general_attributes]) %>
  <% if item_props[:manage_subscription_note].present? %>
    <p><%= item_props[:manage_subscription_note] %></p>
  <% end %>
<% end %>
<% if details.to_s.strip.present? %>
  <div class="item-details"><%= details %></div>
<% end %>
