<%# locals: attributes: [{ label:, value: }], headings: false. A value with no label spans the row.
    With headings, a label with no value is a group heading; elsewhere it is a field left empty. %>
<% if attributes.present? %>
  <table class="details" border="0" cellpadding="0" cellspacing="0">
    <% attributes.each do |attribute| %>
      <% value = safe_join(Array(attribute[:value]).map { |item| auto_link(item.to_s, html: { target: "_blank" }) }, tag.br + " ") %>
      <tr>
        <% if attribute[:label].blank? %>
          <td class="wide" colspan="2"><%= value %></td>
        <% elsif value.blank? && local_assigns[:headings] %>
          <th class="wide" colspan="2"><%= attribute[:label] %></th>
        <% else %>
          <th><%= attribute[:label] %></th>
          <td><%= value %></td>
        <% end %>
      </tr>
    <% end %>
  </table>
<% end %>
