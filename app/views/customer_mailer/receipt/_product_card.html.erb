<div class="product-card">
  <div class="carousel">
    <div class="items">
      <% thumbnail_url = product[:thumbnail_url] || ActionController::Base.helpers.asset_url("native_types/thumbnails/#{product[:native_type]}.png") %>
      <%= link_to(image_tag(thumbnail_url, alt: product[:name]), product[:url], target: "_blank") %>
    </div>
  </div>
  <div class="header">
    <h4>
      <%= link_to(product[:name], product[:url], target: "_blank") %>
    </h4>
    <% if product[:creator].present? %>
      <div>
        <div class="user">
          <% if product[:creator][:avatar_url].present? %>
            <%= link_to(image_tag(product[:creator][:avatar_url], alt: "Avatar of #{product[:creator][:name]}", class: "user-avatar"), product[:creator][:profile_url], target: "_blank") %>
          <% end %>
          <%= link_to(product[:creator][:name], product[:creator][:profile_url], target: "_blank", class: "user-name") %>
        </div>
      </div>
    <% end %>
    <% if product[:ratings].present? %>
      <div class="rating">
        ★
        <% if product[:ratings][:count].positive? %>
          <span class="rating-average"><%= product[:ratings][:average] %></span>
          <%= "(#{number_to_si(product[:ratings][:count])})" %>
        <% else %>
          No ratings
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="footer">
    <div>
      <span style="display: inline-block; position: relative; padding: 0.25rem 0.5rem; padding-right: calc(0.5rem + 1em); border: 1px solid #e5e7eb; border-right: 0; background: linear-gradient(to left, transparent 0%, transparent 1em, #ec4899 1em); background-repeat: no-repeat; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #000000;">
        <%= product_card_formatted_price(
          price: product[:price_cents],
          currency_code: product[:currency_code],
          is_pay_what_you_want: product[:is_pay_what_you_want],
          recurrence: product[:recurrence],
          duration_in_months: product[:duration_in_months]
        ) %>
        <span style="position: absolute; top: 0; bottom: 0; right: 0; width: 1em; height: 100%;">
          <span style="position: absolute; top: 0; left: 0.0625rem; width: 0; height: 0; border-style: solid; border-width: calc(0.25rem + 0.5lh) 0 calc(0.25rem + 0.5lh) 0.0625rem; border-color: transparent transparent transparent #e5e7eb;"></span>
          <span style="position: absolute; top: 0; left: 0.125rem; width: 0; height: 0; border-style: solid; border-width: calc(0.25rem + 0.5lh) 0 calc(0.25rem + 0.5lh) 1em; border-color: transparent transparent transparent #ec4899;"></span>
        </span>
      </span>
    </div>
  </div>
</div>
