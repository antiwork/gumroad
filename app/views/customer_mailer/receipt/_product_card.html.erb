<% thumbnail_url = product[:thumbnail_url] || image_url("native_types/thumbnails/#{product[:native_type]}.png") %>
<div class="card product-card">
  <%= link_to(image_tag(thumbnail_url, alt: product[:name], width: 232, height: 232), product[:url], target: "_blank") %>
  <h4 class="product-name"><%= link_to(product[:name], product[:url], target: "_blank") %></h4>
  <% if product[:creator].present? %>
    <div class="product-byline">
      <% if product[:creator][:avatar_url].present? %>
        <%= link_to(image_tag(product[:creator][:avatar_url], alt: "Avatar of #{product[:creator][:name]}", class: "avatar", width: 20, height: 20), product[:creator][:profile_url], target: "_blank") %>
      <% end %>
      <%= link_to(product[:creator][:name], product[:creator][:profile_url], target: "_blank") %>
    </div>
  <% end %>
  <p class="product-card-price">
    <strong>
      <%= product_card_formatted_price(
        price: product[:price_cents],
        currency_code: product[:currency_code],
        is_pay_what_you_want: product[:is_pay_what_you_want],
        recurrence: product[:recurrence],
        duration_in_months: product[:duration_in_months]
      ) %>
    </strong>
    <% if product[:ratings].present? && product[:ratings][:count].positive? %>
      <span class="rating">
        ★
        <%= product[:ratings][:average] %>
        <%= "(#{number_to_si(product[:ratings][:count])})" %>
      </span>
    <% end %>
  </p>
</div>
