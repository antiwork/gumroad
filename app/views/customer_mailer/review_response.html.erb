<%= header_section("#{@seller_presenter[:name]} responded to your review") %>

<div class="card">
  <%= render("shared/mailers/review_rating", rating: @review_presenter[:rating]) %>
  <% if @review_presenter[:message] %>
    <p><%= "#{@review_presenter[:message]}" %></p>
  <% end %>
  <p class="byline">
    <img class="avatar" src="<%= @review_presenter[:rater][:avatar_url] %>" alt="<%= @review_presenter[:rater][:name] %>" width="24" height="24">
    <span><%= @review_presenter[:rater][:name] %></span>
  </p>

  <div class="card">
    <p><%= "#{@review_presenter[:response][:message]}" %></p>
    <p class="byline">
      <img class="avatar" src="<%= @seller_presenter[:avatar_url] %>" alt="<%= @seller_presenter[:name] %>" width="24" height="24">
      <span><%= @seller_presenter[:name] %></span>
      <span class="pill">Creator</span>
    </p>
  </div>
</div>

<p><%= link_to "View product", @product.long_url, class: "button primary" %></p>
