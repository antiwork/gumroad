<div class="card">
  <p>Name: <%= user.name.presence || "<none set>" %> (user id: <%= user.external_id %>)</p>
  <p>
    Public email: <%= user.email %>
    <br>
    <% if user.username %>
      Username: <%= link_to user.username, user.profile_url %>
      <br>
    <% end %>
    Signed up: <%= user.created_at.to_fs(:formatted_date_full_month) %>
    <br>
    Balance: <%= user.balance_formatted %>
    <br>
    <% lost_chargebacks = user.lost_chargebacks_bounded %>
    Lost Chargebacks: <%= lost_chargebacks ? "#{lost_chargebacks[:volume]} (#{lost_chargebacks[:count]})" : "unavailable (too large to compute)" %>
  </p>
</div>
