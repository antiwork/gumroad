<%= header_section("Low balance for #{@user.name}") %>
<div>
  <p>
    Last refunded purchase:
    <%= @purchase.email %> (purchase id: <%= @purchase.external_id %>)
    <% if @purchase.card_type == CardType::PAYPAL %>
      <%= PaypalChargeProcessor::DISPLAY_NAME %>
    <% end %>
  </p>

  <p>
    Last refunded product:
    <%= @product.name %> (<%= @product.unique_permalink %>)
  </p>

  <p>Creator:</p>
  <%= render("admin_mailer/internal_user_info", user: @user) %>
</div>
