<main class="grid divide-y divide-border bg-background border border-border rounded mx-auto my-4 h-min max-w-md w-[calc(100%-2rem)]">
  <header class="flex flex-col gap-2 p-4">
    <h2>Request a refund</h2>
    <p class="text-muted"><%= @purchase.link.name %> — <%= @purchase.formatted_display_price %></p>
  </header>

  <% if @refund_request.present? %>
    <section class="flex flex-col gap-4 p-4">
      <% case @refund_request.state %>
      <% when "requested", "seen" %>
        <p><strong>Your refund request has been sent to the creator.</strong></p>
        <p>The creator has <%= PurchaseRefundRequest::ESCALATION_BUSINESS_DAYS %> business days to respond. If they don't, Gumroad support will step in. You'll hear from us at <%= @refund_request.email %>.</p>
      <% when "refunded" %>
        <p><strong>This purchase has been refunded.</strong></p>
        <p>Refunds usually appear on your statement within 5&ndash;10 business days.</p>
      <% when "declined" %>
        <p><strong>The creator declined this refund request.</strong></p>
        <p>If you believe this is a mistake, reply to your receipt email or contact <a href="mailto:support@gumroad.com">support@gumroad.com</a>.</p>
      <% when "expired" %>
        <p><strong>This refund request expired and Gumroad support is taking a look.</strong></p>
        <p>You can also contact <a href="mailto:support@gumroad.com">support@gumroad.com</a> directly.</p>
      <% end %>
      <p class="text-muted">Reason: <%= PurchaseRefundRequest::REASON_LABELS[@refund_request.reason] %></p>
    </section>
  <% elsif @eligible %>
    <%= form_with url: purchase_refund_request_path(params[:purchase_id]), method: :post, local: true, html: { class: "flex flex-col gap-4 p-4" } do |f| %>
      <% if flash[:alert].present? %>
        <div role="alert" class="border border-border rounded p-2"><%= flash[:alert] %></div>
      <% end %>
      <p>Tell the creator why you'd like a refund. They have <%= PurchaseRefundRequest::ESCALATION_BUSINESS_DAYS %> business days to respond; if they don't, Gumroad support will step in. No money moves until the creator (or Gumroad) approves the refund.</p>
      <fieldset class="flex flex-col gap-2">
        <legend><strong>Reason</strong></legend>
        <% PurchaseRefundRequest::REASON_LABELS.each do |value, label| %>
          <label class="flex items-center gap-2">
            <%# Standalone Rails page: mirrors components/ui/Radio.tsx classes %>
            <span class="relative inline-flex shrink-0 items-center justify-center">
              <%= f.radio_button :reason, value, required: true,
                    class: "appearance-none size-[calc(1lh+0.125rem)] border border-border bg-background text-base leading-snug shrink-0 cursor-pointer disabled:cursor-not-allowed disabled:opacity-30 checked:bg-accent-with-text rounded-full peer" %>
              <span class="pointer-events-none absolute hidden size-[0.65rem] rounded-full bg-accent-foreground peer-checked:block"></span>
            </span>
            <%= label %>
          </label>
        <% end %>
      </fieldset>
      <label class="flex flex-col gap-1">
        <strong>Anything else the creator should know? (optional)</strong>
        <%# Mirrors components/ui/Textarea.tsx (baseInputStyles + resize-y) %>
        <%= f.text_area :message, rows: 4, maxlength: PurchaseRefundRequest::MAX_MESSAGE_LENGTH,
              class: "font-[inherit] py-3 px-4 text-base leading-snug text-foreground border border-border rounded block w-full bg-background placeholder:text-muted focus:outline-2 focus:outline-indicator focus:outline-offset-0 opacity-100 disabled:cursor-not-allowed disabled:bg-active-bg forced-colors:disabled:border-dashed resize-y" %>
        <span class="text-muted">(max <%= PurchaseRefundRequest::MAX_MESSAGE_LENGTH %> characters)</span>
      </label>
      <%= f.submit "Send refund request", class: "button primary" %>
    <% end %>
  <% else %>
    <section class="flex flex-col gap-4 p-4">
      <p><strong>This purchase isn't eligible for a refund request.</strong></p>
      <% if @purchase.refunded? %>
        <p>It has already been refunded.</p>
      <% elsif @purchase.chargedback? %>
        <p>It has already been disputed with your bank.</p>
      <% else %>
        <p>It may be outside the creator's refund window, or a previous request was already resolved. If you still need help, contact <a href="mailto:support@gumroad.com">support@gumroad.com</a> and include your receipt.</p>
      <% end %>
    </section>
  <% end %>
</main>
<% content_for :footer do %>
  <%= default_footer_content %>
<% end %>
