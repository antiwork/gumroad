<div id="<%= "#{method[:type]}-#{method[:path]}" %>">
  <div class="paragraphs">
    <p role="heading" aria-level="3">
      <span class="pill primary"><%= method[:type].upcase %></span>
      <span><%= method[:path] %></span>
    </p>
    <p><%= method[:description].html_safe %></p>
    <%= render "shared/code_snippet" do %>
<a><%= method[:is_oauth].present? ? "https://gumroad.com#{method[:path]}" : "https://api.gumroad.com/v2#{method[:path]}" %></a>
    <% end %>
    <% if method[:parameters_layout].present? %>
      <div class="parameters">
        <h4>Parameters:</h4>
        <%= render "public/api/parameters/#{method[:parameters_layout]}" %>
      </div>
    <% end %>
    <% if method[:curl_layout].present? %>
      <%= render "shared/code_snippet", caption: "cURL example" do %>
<%= render "public/api/curl/#{method[:curl_layout]}" %>
      <% end %>
    <% end %>
    <% if method[:response_layout].present? %>
      <%= render "shared/code_snippet", caption: "Example response:" do %>
<%= render "public/api/response/#{method[:response_layout]}" %>
      <% end %>
    <% end %>
  </div>
</div>
