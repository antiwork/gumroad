<%= header_section(@subject) %>
<div>
  <p>
    You have been invited to become an affiliate for <%= @product_name %>. If you approve this invitation, you'll be able to share these products with your audience and earn <%= @affiliate_percentage_text %> commission on every sale you make.
  </p>

  <p>
    <strong>To get started, please approve this invitation by visiting your Affiliated Products dashboard:</strong>
  </p>

  <p>
    <%= link_to "Review and Approve Invitation", products_affiliated_index_url, class: "button primary" %>
  </p>

  <p>Once you approve the invitation, you'll be able to access your affiliate links and start earning commissions.</p>
  <h3>What products are you being invited to promote?</h3>
  <ul>
    <% @products.each do |product| %>
      <li>
        <strong><%= product[:name] %></strong>
        <span> - Your commission: <%= product[:fee_percent] %>%</span>
      </li>
    <% end %>
  </ul>

  <p>
    If you have any questions about this invitation, you can contact <%= @seller_name %> directly.
  </p>
  <%= render("notify_affiliate_footer") %>
</div>
