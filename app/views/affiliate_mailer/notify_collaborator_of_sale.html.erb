<%= header_section(@mail_heading, @mail_subheading) %>
<%= render("contacting_creator_mailer/notify_top_section") %>

<div class="squished">
  <% if @purchase.present? %>
    <table>
      <tbody>
        <% if @buyer_email.present? %>
          <tr>
            <td>
              <h4>Customer email</h4>
            </td>
            <td><%= @buyer_email %></td>
          </tr>
        <% end %>
        <tr>
          <td>
            <h4>Product price</h4>
          </td>
          <td><%= @purchase.formatted_display_price %></td>
        </tr>
        <% if @direct_affiliate_commission_formatted.present? %>
          <tr>
            <td>
              <h4>Affiliate commission</h4>
            </td>
            <td>-<%= @direct_affiliate_commission_formatted %> (<%= @direct_affiliate_percentage_text %>)</td>
          </tr>
        <% end %>
        <tr>
          <td>
            <h4>Your cut</h4>
          </td>
          <td><%= @cut %></td>
        </tr>
        <% if @fee_share_cents.positive? %>
          <tr>
            <td>
              <h4>Your share of fees</h4>
            </td>
            <td>-<%= @fee_share_formatted %></td>
          </tr>
          <tr>
            <td>
              <h4>Added to your balance</h4>
            </td>
            <td><%= @credited_formatted %></td>
          </tr>
        <% end %>
        <% if @quantity.present? %>
          <tr>
            <td>
              <h4>Quantity</h4>
            </td>
            <td><%= @quantity %></td>
          </tr>
        <% end %>
        <% if @variants.present? %>
          <tr>
            <td>
              <h4><%= @product.is_tiered_membership ? "Tier" : "Variant".pluralize(@variants_count) %></h4>
            </td>
            <td><%= @variants %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>

<% if @purchase&.is_free_trial_purchase? %>
  <div>
    <p>If the subscriber continues with their subscription after their free trial has expired<%= " on #{@free_trial_end_date}" if @free_trial_end_date %>, we'll add your cut to your balance.</p>
  </div>
<% end %>

<% if @purchase.nil? || @purchase.is_test_purchase? %>
  <div>
    <p>Because this was a test sale, this amount will not be added to your account balance.</p>
  </div>
<% end %>
