<%# layouts/email.html.erb without route helpers: this is rendered once per blast outside a request,
    so their URL options (the hostname) would be wrong. Keep the two in step. Nothing
    recipient-specific may be rendered here either; that is what the {{merge tags}} are for. %>
<!DOCTYPE html>
<html lang="en" xmlns:o="urn:schemas-microsoft-com:office:office">
  <head>
    <title>{{subject}}</title>
    <% follows_reader_color_scheme = @post.user.seller_profile.email_follows_reader_color_scheme? %>
    <%= render("layouts/mailers/head", color_scheme: follows_reader_color_scheme ? "light dark" : nil) %>
    <style><%= @post.user.seller_profile.custom_styles.to_s.html_safe %></style>
    <style><%= @post.user.seller_profile.email_page_background_css.html_safe %></style>
    <%= vite_entrypoint_stylesheet_tag "email" %>
    <%# Outlook on Windows resolves neither `inherit` nor `currentColor`, so a post's links and
        outline buttons would be blue and unbordered there. This names the theme's text colour
        for them. It comes after the stylesheet, and each selector carries a tag, so it outranks
        the stylesheet's own `inherit` rules but not a filled button's. %>
    <% text_color = @post.user.seller_profile.text_color_on_background %>
    <style>
      div.email.post a, div.email.post .title, div.email.post .muted a, div.email.post .footer a,
      div.email.post .footer .wordmark, div.email.post .product-byline a, div.email.post th a { color: <%= text_color %>; }
      div.email.post .button { border-color: <%= text_color %>; color: <%= text_color %>; }
    </style>
    <% if follows_reader_color_scheme %>
      <%# For a dark-mode reader: no background, so the mail client's own dark page shows, and
          light text. A filled button keeps its colours, and a code block keeps its light box.
          Only a client that reads prefers-color-scheme uses this (Apple Mail, Outlook.com);
          Gmail inverts an email itself. Premailer cannot inline a media query, hence the ignore. %>
      <style data-premailer="ignore">
        @media (prefers-color-scheme: dark) {
          body, .email.post { background-color: transparent !important; color: #ffffff !important; }
          .email.post a:not(.button), .email.post .button:not(.primary):not(.accent) { color: #ffffff !important; }
          .email.post .button:not(.primary):not(.accent) { border-color: #ffffff !important; }
        }
      </style>
    <% end %>
  </head>
  <body>
    <%= render("shared/preheader_text", text: CGI.unescapeHTML(@post.truncated_description)) %>
    <div class="email post" style="<%= @post.user.seller_profile.email_body_style %>">
      <!--[if mso]><table role="presentation" align="center" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
      <div class="main">
        <% if @has_post_url %>
          <%= header_section(post_title_displayable(post: @post, url: "{{post_url}}")) %>
        <% else %>
          <%= header_section(post_title_displayable(post: @post)) %>
        <% end %>

        <%# dir="auto" on the container plus per-block direction below lets email clients
            pick text direction per paragraph from its first strong character, so
            Hebrew/Arabic paragraphs read right-to-left even after an English intro, while
            Latin-script content is unaffected (gumroad-private#1244). %>
        <div class="rich-text" dir="auto">
          <%= with_per_block_text_direction(Rinku.auto_link(@post.message_with_inline_syntax_highlighting_and_upsells&.html_safe, :all, %(target="_blank" rel="nofollow")).html_safe) %>

          <% if @post.call_to_action_url.present? %>
            <p>
              <a class="button accent" href="<%= @post.call_to_action_url %>" target="_blank"><%= @post.call_to_action_text %></a>
            </p>
          <% end %>
        </div>

        <% if @has_download_button || @has_comment_button %>
          <% primary_button_style = @post.user.seller_profile.email_primary_button_style %>
          <p class="actions">
            <% if @has_download_button %>
              <a class="button primary" href="{{download_url}}" style="<%= primary_button_style %>">{{t_view_attachments_prompt}}</a>
            <% end %>
            <% if @has_comment_button && @has_download_button %>
              <a class="button" href="{{post_url}}#comments" target="_blank">{{t_post_a_comment}}</a>
            <% elsif @has_comment_button %>
              <a class="button primary" href="{{post_url}}#comments" target="_blank" style="<%= primary_button_style %>">{{t_post_a_comment}}</a>
            <% end %>
          </p>
        <% end %>
      </div>
      <div class="footer">
        <p>
          {{seller_update_reason}}
          <a href="{{unsubscribe_url}}">{{t_unsubscribe}}</a>
        </p>
        <p><%= GumroadAddress.full %></p>
        <% unless Rails.env.production? %>
          <p>(⌐▨_▨) <%= Rails.env.capitalize %> (▨_▨¬)</p>
        <% end %>
        <a class="wordmark" href="<%= @gumroad_url %>">
          {{t_powered_by}}
          <%# The halo file is taller than the plain mark by its halo. %>
          <img src="<%= image_url(@post.user.seller_profile.email_wordmark_image_path) %>" alt="Gumroad" width="92" height="<%= follows_reader_color_scheme ? 15 : 12 %>">
        </a>
      </div>
      <!--[if mso]></td></tr></table><![endif]-->
    </div>
  </body>
</html>
