<% product_name = @variant ? "#{@product.name} (#{@variant.name})" : @product.name %>
<% price_cents = @product.price_cents + @variant&.price_difference_cents.to_i %>
<% format_price = ->(cents) { MoneyFormatter.format(cents, @product.price_currency_type, no_cents_if_whole: true, symbol: true) } %>
<% price = format_price.(@offer_code ? price_cents - @offer_code.amount_off(price_cents) : price_cents) %>
<% price = safe_join([tag.s(format_price.(price_cents)), price], " ") if @offer_code %>
<div class="card">
  <%= render("shared/mailers/product", product: { name: product_name, url: @upsell_url, thumbnail_url: @product.for_email_thumbnail_url }, price:) %>
</div>
