<div class="card">
  <% @products.take(Installment::MAX_ABANDONED_CART_PRODUCTS_TO_SHOW_IN_EMAIL).each do |product| %>
    <% seller = product[:seller] %>
    <% byline = capture do %>
      <%= link_to(image_tag(seller[:avatar_url], alt: "Avatar of #{seller[:name]}", class: "avatar", width: 24, height: 24), seller[:profile_url], target: "_blank") %>
      <%= link_to(seller[:name], seller[:profile_url], target: "_blank") %>
    <% end %>
    <%= render("shared/mailers/product", product:, byline:) %>
  <% end %>
</div>
<% if @products.size > Installment::MAX_ABANDONED_CART_PRODUCTS_TO_SHOW_IN_EMAIL %>
  <p>
    <%= link_to "and #{pluralize(@products.size - Installment::MAX_ABANDONED_CART_PRODUCTS_TO_SHOW_IN_EMAIL, 'more product')}", checkout_url(host: UrlService.domain_with_protocol), target: "_blank" %>
  </p>
<% end %>
<p>
  <%= link_to "Complete checkout", checkout_url(host: UrlService.domain_with_protocol), target: "_blank", class: "button primary" %>
</p>
