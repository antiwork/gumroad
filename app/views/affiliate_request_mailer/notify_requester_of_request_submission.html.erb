<%= header_section(@subject) %>
<div>
  <p><%= @affiliate_request.seller.display_name %> is now reviewing your application and once they approve you, you will receive a confirmation email, along with some helpful tips to get started as an affiliate.</p>
  <%= render("affiliate_request_mailer/request", affiliate_request: @affiliate_request) %>
</div>

<% unless @requester_has_existing_account %>
  <div class="callout">
    <p><strong>In the meantime, <%= link_to "create your Gumroad account", signup_url(email: @affiliate_request.email) %> using email <%= @affiliate_request.email %> and confirm it. You'll receive your affiliate links once your Gumroad account is active.</strong></p>
  </div>
<% end %>
