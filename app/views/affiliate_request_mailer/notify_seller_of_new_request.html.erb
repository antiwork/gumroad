<%= header_section(@subject) %>
<div>
  <%= render("affiliate_request_mailer/request", affiliate_request: @affiliate_request) %>
</div>
<p class="actions">
  <%= link_to "Approve", approve_affiliate_request_url(@affiliate_request), class: "button primary" %>
