<%= header_section(@subject) %>
<div>
  <p>
    Congratulations, you are now an official affiliate for <%= @affiliate_request.seller.display_name %>!
  </p>
  <p>
    You can now promote these products using these unique URLs:
  </p>
  <ul class="link-list">
    <% @affiliated_products.each do |affiliated_product| %>
      <li>
        <strong><%= affiliated_product[:name] %></strong>
        <span class="muted">(<%= affiliated_product[:commission] %> commission)</span>
        <br>
        <%= link_to affiliated_product[:url], affiliated_product[:url], clicktracking: "off" %>
      </li>
    <% end %>
  </ul>
</div>
<div>
  <h3>How do you share products with your audience?</h3>
  <p>
    You can direct them
    to any of the URLs provided above, and they will be redirected to that specific
    product. That's it!
  </p>
</div>
<%= render("affiliate_mailer/notify_affiliate_footer") %>
<p><%= link_to "View all affiliated products", products_affiliated_index_url, class: "button primary" %></p>
