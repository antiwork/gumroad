<%# Crawl fallback for the client-rendered Discover app: a heading, and the category, search
    result and pagination hrefs, in the initial HTML for crawlers that don't execute JS.
    noscript keeps it out of the rendered UI. %>
<noscript>
  <%# Same text as the <h1> the Discover app renders. A search outside a category has no visible
      <h1>, so its heading is the search phrase from the page title. %>
  <% if @discover_seo_heading.present? %>
    <h1><%= @discover_seo_heading %></h1>
  <% end %>
  <% if @discover_seo_description.present? %>
    <p><%= @discover_seo_description %></p>
  <% end %>
  <% if @discover_category_links.present? %>
    <nav aria-label="Categories">
      <ul>
        <% @discover_category_links.each do |link| %>
          <li><a href="<%= link[:href] %>"><%= link[:label] %></a></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
  <%# Product names are seller text. Keep them as escaped ERB output, never html_safe: noscript is
      a raw-text element, so an unescaped closing tag in a name would end it early. %>
  <% if @discover_result_links.present? %>
    <nav aria-label="Search results">
      <ul>
        <% @discover_result_links.each do |link| %>
          <li><a href="<%= link[:href] %>"><%= link[:label] %></a></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
  <% if @discover_pagination_links.present? %>
    <nav aria-label="Pagination">
      <ul>
        <% @discover_pagination_links.each do |link| %>
          <li><a href="<%= link[:href] %>"><%= link[:label] %></a></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
</noscript>
