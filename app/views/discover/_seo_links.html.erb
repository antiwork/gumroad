<%# Crawl fallback for the client-rendered Discover app: a heading, and the category and
    pagination hrefs, in the initial HTML for crawlers that don't execute JS. noscript keeps
    it out of the rendered UI. %>
<noscript>
  <%# The Discover app renders its own heading client-side; this one exists so the served
      HTML is not heading-less for a fetcher that does not run JavaScript. %>
  <% if @discover_seo_heading.present? %>
    <h1><%= @discover_seo_heading %></h1>
  <% end %>
  <% if @discover_seo_description.present? %>
    <p><%= @discover_seo_description %></p>
  <% end %>
  <% if @discover_category_links.present? %>
    <nav aria-label="Categories">
      <ul>
        <% @discover_category_links.each do |link| %>
          <li><a href="<%= link[:href] %>"><%= link[:label] %></a></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
  <% if @discover_pagination_links.present? %>
    <nav aria-label="Pagination">
      <ul>
        <% @discover_pagination_links.each do |link| %>
          <li><a href="<%= link[:href] %>"><%= link[:label] %></a></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
</noscript>
