<%# Crawl fallback for the client-rendered Discover app: category and pagination hrefs
    in the initial HTML for crawlers that don't execute JS. noscript keeps it out of the
    rendered UI. %>
<noscript>
  <nav aria-label="Categories">
    <ul>
      <% @discover_category_links.each do |link| %>
        <li><a href="<%= link[:href] %>"><%= link[:label] %></a></li>
      <% end %>
    </ul>
  </nav>
  <% if @discover_pagination_links.present? %>
    <nav aria-label="Pagination">
      <ul>
        <% @discover_pagination_links.each do |link| %>
          <li><a href="<%= link[:href] %>"><%= link[:label] %></a></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
</noscript>
