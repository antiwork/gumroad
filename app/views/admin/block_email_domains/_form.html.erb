<%= form_for :email_domains, url: url, method: :put do |f| %>
  <section>
    <header>
      <%= header %>
    </header>
    <p>
      For emails like
      <code>john@example.com</code>,
      <code>john@example.net</code>,
      <code>john@list.example.org</code>,
      enter what is to the right of
      <code>@</code> character.
    </p>
    <%= render "shared/code_snippet", caption: "Example with comma-separated items" do %>
example.com, example.net, list.example.org
    <% end %>
    <%= render "shared/code_snippet", caption: "Example with items separated by newline" do %>
example.com
example.net
list.example.org
    <% end %>
    <%= f.text_area :identifiers, placeholder: "Enter email domains here", rows: 10 %>
    <%= f.button button_label, class: "button primary" %>
  </section>
<% end %>
