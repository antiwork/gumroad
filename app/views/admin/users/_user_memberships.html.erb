<%# TODO: When migrating to React/Inertia, use the Stack component instead of these Tailwind classes %>
<% stack_classes = "grid bg-filled border border-border rounded stack-component [&>*]:flex [&>*]:flex-wrap [&>*]:items-center [&>*]:p-4 [&>*]:gap-4 [&>*]:justify-between [&>*:not(:first-child)]:border-t [&>*:not(:first-child)]:border-border [&>*>:first-child]:flex-grow [&>*>:first-child:where(.button,fieldset)]:flex-[0_1_0%] [&>*>:where(.button,fieldset)+:where(.button,fieldset)]:flex-1 [&>*_h4]:font-bold [&>*_h5]:font-bold [&>*_h6]:font-bold [&>details]:block [&>details_summary]:grid [&>details_summary]:grid-flow-col [&>details_summary]:grid-cols-[1fr_auto] [&>details_summary::before]:col-start-2" %>

<% user_memberships = user.user_memberships_not_deleted_and_ordered.reject { |team_membership| team_membership.role_owner? } %>
<% if user_memberships.any? %>
  <hr>
  <details>
    <summary>
      <h3>User memberships</h3>
    </summary>
    <div class="<%= stack_classes %>">
      <% user_memberships.each do |user_membership| %>
        <div>
          <div style="display: flex; gap: var(--spacer-4); align-items: center">
            <%= image_tag(user_membership.seller.avatar_url, class: "user-avatar", alt: user_membership.seller.display_name(prefer_email_over_default_username: true)) %>
            <div style="display: grid;">
              <h5><%= link_to(user_membership.seller.display_name(prefer_email_over_default_username: true), admin_user_url(user_membership.seller.id)) %></h5>
              <div class="small">
                <%= user_membership.role %>
              </div>
            </div>
          </div>
          <div style="text-align: right">
            <% if user_membership.last_accessed_at %>
              last accessed
              <%= format_datetime_with_relative_tooltip(user_membership.last_accessed_at) %>
            <% end %>
            <div class="small">
              invited
              <%= format_datetime_with_relative_tooltip(user_membership.created_at) %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </details>
<% end %>
