<%= load_pack("admin_review") %>

<div class="paragraphs">
  <%= render("admin/users/user", user: user, is_affiliate_user: is_affiliate_user) %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const productsContentElement = document.getElementById('products-content');
  if (productsContentElement && productsContentElement.innerHTML.trim() === '') {
    productsContentElement.innerHTML = `
      <div class="paragraphs">
        <h3><%= is_affiliate_user ? "Affiliated products" : "Created products" %></h3>
        <% if products.none? %>
          <div class="info" role="status"><%= is_affiliate_user ? "No affiliated products." : "No products created." %></div>
        <% else %>
          <% products.each do |product| %>
            <%= escape_javascript(render("admin/links/product", product: product, show_purchases: true, is_affiliate_user: is_affiliate_user, user_id: user.id)) %>
          <% end %>
          <% if pagy.pages > 1 %>
            <div class="pagination" role="navigation" aria-label="Pagination">
              <%= escape_javascript(link_to("‹ Previous", pagy_url_for(pagy, pagy.prev), class: "button", inert: !pagy.prev)) %>
              <menu>
                <% (1..pagy.pages).map do |page| %>
                  <li><%= escape_javascript(link_to(page, pagy_url_for(pagy, page), class: "button", inert: page == pagy.page)) %></li>
                <% end %>
              </menu>
              <%= escape_javascript(link_to("Next ›", pagy_url_for(pagy, pagy.next), class: "button", inert: !pagy.next)) %>
            </div>
          <% end %>
        <% end %>
      </div>
    `;
  }
});
</script>
