<%= load_pack("admin_review") %>

<div role="tablist" class="tab-pills">
  <div role="tab" aria-selected="true" onclick="showTab('account')" id="account-tab">
    Account
  </div>
  <div role="tab" aria-selected="false" onclick="showTab('products')" id="products-tab">
    Products
  </div>
  <div role="tab" aria-selected="false" onclick="showTab('purchases')" id="purchases-tab">
    Purchases
  </div>
</div>

<div role="tabpanel" style="margin-top: var(--spacer-4)">
  <div id="account-content" style="display: block;">
    <div class="paragraphs">
      <%= render("admin/users/user", user: user, is_affiliate_user: is_affiliate_user) %>
    </div>
  </div>

  <div id="products-content" style="display: none;">
    <div class="paragraphs">
      <h3><%= is_affiliate_user ? "Affiliated products" : "Created products" %></h3>
      <% if products.none? %>
        <div class="info" role="status"><%= is_affiliate_user ? "No affiliated products." : "No products created." %></div>
      <% else %>
        <% products.each do |product| %>
          <%= render("admin/links/product", product: product, show_purchases: true, is_affiliate_user: is_affiliate_user, user_id: user.id) %>
        <% end %>
        <% if pagy.pages > 1 %>
          <div class="pagination" role="navigation" aria-label="Pagination">
            <%= link_to("‹ Previous", pagy_url_for(pagy, pagy.prev), class: "button", inert: !pagy.prev) %>
            <menu>
              <% (1..pagy.pages).map do |page| %>
                <li><%= link_to(page, pagy_url_for(pagy, page), class: "button", inert: page == pagy.page) %></li>
              <% end %>
            </menu>
            <%= link_to("Next ›", pagy_url_for(pagy, pagy.next), class: "button", inert: !pagy.next) %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

  <div id="purchases-content" style="display: none;">
    <div class="paragraphs">
      <h3><%= is_affiliate_user ? "All affiliate purchases" : "All purchases" %></h3>
      <div class="info" role="status">
        Purchases aggregation coming soon. For now, view individual product purchases in the Products tab.
      </div>
    </div>
  </div>
</div>

<script>
function showTab(tabName) {
  const tabs = ['account', 'products', 'purchases'];
  
  tabs.forEach(tab => {
    const tabElement = document.getElementById(tab + '-tab');
    const contentElement = document.getElementById(tab + '-content');
    
    if (tab === tabName) {
      tabElement.setAttribute('aria-selected', 'true');
      contentElement.style.display = 'block';
    } else {
      tabElement.setAttribute('aria-selected', 'false');
      contentElement.style.display = 'none';
    }
  });
}
</script>
