<div class="hero">
  <%= image_tag image_url("email/gumroad_coins.png"), alt: "Cha-ching!", width: 160, height: 130 %>
  <p class="eyebrow">It's pay day!</p>
  <h1><%= @payment_display_amount %></h1>
  <p>has been deposited in your account for sales up until <%= @paid_date %>.</p>
  <p><a class="button primary" href="<%= balance_url %>">View account balance</a></p>
</div>
<% if @revenue_by_link.present? || @credit_amount_cents != 0 || @paypal_payout_amount_cents != 0 || @affiliate_credit_cents != 0 || @stripe_connect_payout_amount_cents != 0 %>
  <% with_currency = @payment_currency != Currency::USD %>
  <table class="list">
    <thead>
      <tr>
        <th>Products</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% if @revenue_by_link.present? %>
        <% @revenue_by_link.each do |link_id, revenue_cents| %>
          <% link = Link.find(link_id.to_i) %>
          <tr>
            <td><a href="<%= link.long_url %>"><%= link.name %></a></td>
            <td class="nowrap"><%= Money.new(revenue_cents.to_i, "USD").format(symbol: true, with_currency:) %></td>
          </tr>
        <% end %>
      <% end %>
      <% if @affiliate_credit_cents != 0 %>
        <tr>
          <td>Affiliate or collaborator fees received</td>
          <td class="nowrap"><%= Money.new(@affiliate_credit_cents, "USD").format(symbol: true, with_currency:) %></td>
        </tr>
      <% end %>
      <% if @credit_amount_cents != 0 %>
        <tr>
          <td>Gumroad credits</td>
          <td class="nowrap"><%= Money.new(@credit_amount_cents, "USD").format(symbol: true, with_currency:) %></td>
        </tr>
      <% end %>
      <% if @paypal_payout_amount_cents != 0 %>
        <tr>
          <td>PayPal Payouts</td>
          <td class="nowrap">- <%= Money.new(@paypal_payout_amount_cents, "USD").format(symbol: true, with_currency:) %></td>
        </tr>
      <% end %>
      <% if @stripe_connect_payout_amount_cents != 0 %>
        <tr>
          <td>Stripe Connect Payouts</td>
          <td class="nowrap">- <%= Money.new(@stripe_connect_payout_amount_cents, "USD").format(symbol: true, with_currency:) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
