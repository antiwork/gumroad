<%= header_section("Your order has shipped!") %>
<div>
  <% if @tracking_link %>
    <p>Your order of <%= @product.name %> is en route and should arrive soon.</p>
    <p>
      <%= link_to(@tracking_link[:label], @tracking_link[:url], class: "button primary") %>
      <% if @tracking_link[:host].present? %>
        <span>Destination: <%= @tracking_link[:host] %></span>
      <% end %>
    </p>
  <% else %>
    <p>Your order of <%= @product.name %> has been shipped and should arrive soon.</p>
  <% end %>
  <p>If you have any questions about the status of the shipment, you can reach out by replying to this email.</p>
</div>
