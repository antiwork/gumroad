<%# Part 1 holds the first products of the catalog, so it is the only part to load. %>
<% catalog_size = migration.catalog_size %>
<ul class="m-0 flex list-disc flex-col gap-1 pl-6">
  <% migration.products.first(PartnerMigration::CONFIRMATION_PREVIEW_SIZE).each do |product| %>
    <li><%= product["name"] %></li>
  <% end %>
  <% if catalog_size > PartnerMigration::CONFIRMATION_PREVIEW_SIZE %>
    <li>and <%= catalog_size - PartnerMigration::CONFIRMATION_PREVIEW_SIZE %> more</li>
  <% end %>
</ul>
