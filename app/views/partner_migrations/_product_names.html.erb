<% product_names = migration.products.map { _1["name"] } %>
<ul class="m-0 flex list-disc flex-col gap-1 pl-6">
  <% product_names.first(PartnerMigration::CONFIRMATION_PREVIEW_SIZE).each do |name| %>
    <li><%= name %></li>
  <% end %>
  <% if product_names.size > PartnerMigration::CONFIRMATION_PREVIEW_SIZE %>
    <li>and <%= product_names.size - PartnerMigration::CONFIRMATION_PREVIEW_SIZE %> more</li>
  <% end %>
</ul>
