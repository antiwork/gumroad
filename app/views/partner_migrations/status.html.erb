<% progress = @migration.progress %>
<% importing = @migration.status == PartnerMigration::STATUS_CLAIMED %>
<% failed = @migration.status == PartnerMigration::STATUS_FAILED %>
<% stopped = @migration.stalled? || (failed && progress[:failed] == 0) %>
<% button_class = "inline-flex items-center justify-center gap-2 cursor-pointer border border-border rounded font-[inherit] no-underline transition-transform hover:-translate-1 hover:shadow active:translate-0 active:shadow-none px-4 py-3 text-base leading-snug" %>
<main class="grid divide-y divide-border bg-background border border-border rounded mx-auto my-4 h-min max-w-xl w-[calc(100%-2rem)]">
  <header class="flex flex-col gap-4 p-4">
    <% if flash[:warning].present? %>
      <p role="alert"><%= flash[:warning] %></p>
    <% end %>
    <h1>
      <% if stopped %>Your import stopped
      <% elsif importing %>Importing your products
      <% elsif failed %>Some products did not import
      <% else %>Your products are ready to review
      <% end %>
    </h1>
    <div class="flex flex-col gap-2" role="status">
      <progress class="w-full" aria-label="Import progress" value="<%= progress[:imported] + progress[:failed] %>" max="<%= progress[:total] %>"></progress>
      <p>
        <%= progress[:imported] %> of <%= pluralize(progress[:total], "product") %> imported<% if progress[:failed] > 0 %>, <%= progress[:failed] %> did not import<% end %>.
        From <strong><%= @migration.oauth_application.name %></strong> to <strong><%= current_user.form_email.presence || "your Gumroad account" %></strong>.
      </p>
    </div>
    <p>
      <% if @migration.stalled? %>The import stopped responding.
      <% elsif importing %>This page updates on its own. You can also close it: we email you when the import finishes.
      <% end %>
      Products stay as drafts until you publish them.
    </p>
    <% if @migration.failure_reason.present? %>
      <p role="alert"><%= @migration.failure_reason %></p>
    <% end %>
    <% if failed || @migration.stalled? %>
      <%= button_to importing ? "Resume import" : stopped ? "Retry import" : "Retry failed products", retry_partner_migration_path(@migration.public_id), method: :post, class: "#{button_class} bg-accent-with-text text-accent-foreground" %>
      <p>Products that already imported stay as they are. If a file link expired, ask <%= @migration.oauth_application.name %> to refresh it first.</p>
      <%# A failed import always keeps a way out of this page, even when nothing imported. %>
      <% if failed || progress[:imported] > 0 %>
        <%= link_to "Review drafts", products_path, class: "underline" %>
      <% end %>
    <% elsif !importing %>
      <%= link_to "Review drafts", products_path, class: "#{button_class} bg-accent-with-text text-accent-foreground" %>
    <% end %>
    <% unless importing %>
      <% steps = [] %>
      <% steps << link_to("Confirm your email", settings_main_path, class: "underline") unless current_user.confirmed? %>
      <% steps << link_to("Set up payouts", settings_payments_path, class: "underline") unless current_user.can_publish_products? %>
      <% steps << link_to("Update your profile", profile_path, class: "underline") %>
      <div class="flex flex-col gap-2">
        <h2>Before you sell</h2>
        <ul class="m-0 flex list-disc flex-col gap-1 pl-6">
          <% steps.each do |step| %>
            <li><%= step %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </header>
  <ol class="m-0 list-none divide-y divide-border p-0">
    <% @migration.products.each_with_index do |attributes, index| %>
      <% result = @migration.results.to_h[index.to_s] || {} %>
      <% product = result["product_id"].present? ? @products[result["product_id"]] : nil %>
      <% product = nil if product&.deleted? %>
      <li class="flex flex-col gap-1 p-4">
        <% if product %>
          <%= link_to attributes["name"], edit_link_path(product.unique_permalink), class: "underline" %>
          <span><%= product.banned_at? ? "Removed" : product.draft? ? "Draft" : product.alive? ? "Published" : "Unpublished" %></span>
        <% else %>
          <span><%= attributes["name"] %></span>
          <% if result["error"].present? %>
            <span>Did not import: <%= result["error"] %></span>
          <% elsif result["product_id"].present? %>
            <span>Removed from your account.</span>
          <% else %>
            <span>Waiting</span>
          <% end %>
        <% end %>
        <% Array(result["warnings"]).each do |warning| %>
          <span><%= warning %></span>
        <% end %>
      </li>
    <% end %>
  </ol>
</main>
