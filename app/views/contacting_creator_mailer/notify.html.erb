<%= render("notify_top_section") %>

<% affiliate = @purchase&.affiliate %>
<% call = @purchase&.call %>

<% if @purchase.present? %>
  <table class="details">
    <% if @shipping_info.nil? && @purchase.quantity > 1 %>
      <tr>
        <th>Quantity</th>
        <td><%= @purchase.quantity %></td>
      </tr>
    <% end %>
    <% if @buyer_name.present? %>
      <tr>
        <th>Customer</th>
        <td><%= @buyer_name %></td>
      </tr>
    <% end %>
    <tr>
      <th>Email</th>
      <td><%= @purchaser_email %></td>
    </tr>
    <% if call.present? %>
      <tr>
        <th>Call schedule</th>
        <td>
          <span class="nowrap"><%= call.formatted_time_range %></span>
          <br>
          <%= call.formatted_date_range %>
        </td>
      </tr>
    <% end %>
    <% if @shipping_info.present? %>
      <tr>
        <th>Shipping address</th>
        <td>
          <%= @shipping_info["full_name"] %>
          <br>
          <%= @shipping_info["street_address"] %>
          <br>
          <%= @shipping_info["city"] %>, <%= @shipping_info["state"] %> <%= @shipping_info["zip_code"] %>
          <br>
          <%= @shipping_info["country"] %>
        </td>
      </tr>
    <% else %>
      <%= render partial: "notify_table_discount_upsell_rows" %>
    <% end %>
    <% is_coffee = @product.native_type == Link::NATIVE_TYPE_COFFEE %>
    <% if @quantity.present? && !is_coffee && call.blank? %>
      <tr>
        <th>Quantity</th>
        <td><%= @quantity %></td>
      </tr>
    <% end %>
    <% if @variants.present? && !is_coffee && call.blank? %>
      <tr>
        <th><%= @product.is_tiered_membership ? "Tier" : "Variant".pluralize(@variants_count) %></th>
        <td><%= @variants %></td>
      </tr>
    <% end %>
    <% if @purchase.commission.present? %>
      <tr>
        <th>Deposit paid</th>
        <td class="nowrap"><%= @purchase.formatted_display_price %></td>
      </tr>
    <% end %>
    <% if @purchase.tip.present? %>
      <tr>
        <th>Tip</th>
        <td class="nowrap"><%= format_just_price_in_cents(@purchase.tip.value_cents, @purchase.displayed_price_currency_type) %></td>
      </tr>
    <% end %>
    <% if call.present? %>
      <tr>
        <th>Duration</th>
        <td><%= @purchase.variant_attributes.first.name %></td>
      </tr>
    <% end %>
    <% direct_affiliate_credit = @purchase.credits_direct_affiliate? ? @purchase.direct_affiliate_credit : nil %>
    <% if direct_affiliate_credit.present? %>
      <tr>
        <th>Affiliate email</th>
        <td><%= direct_affiliate_credit.affiliate_user.form_email %></td>
      </tr>
      <tr>
        <th>Affiliate commission</th>
        <td class="nowrap"><%= "#{Money.new(direct_affiliate_credit.amount_cents + direct_affiliate_credit.fee_cents).format(no_cents_if_whole: true, symbol: true)} (#{direct_affiliate_credit.basis_points / 100}%)" %></td>
      </tr>
    <% end %>
    <% if affiliate.present? && !@purchase.affiliate_credit_cents.zero? && @purchase.affiliate_credit.present? %>
      <tr>
        <th><%= affiliate.collaborator? ? "Collaborator email" : "Affiliate email" %></th>
        <td><%= affiliate.affiliate_user.form_email %></td>
      </tr>
      <tr>
        <th><%= affiliate.collaborator? ? "Collaborator commission" : "Affiliate commission" %></th>
        <td class="nowrap"><%= "#{Money.new(@purchase.own_affiliate_credit_cents + @purchase.affiliate_credit.fee_cents).format(no_cents_if_whole: true, symbol: true)} (#{@purchase.affiliate_credit.basis_points / 100}%#{" of the rest" if direct_affiliate_credit.present?})" %></td>
      </tr>
    <% end %>
    <% if @purchase.utm_link.present? %>
      <tr>
        <th><%= link_to "UTM link", @purchase.utm_link.utm_url, rel: "noopener noreferrer nofollow", target: "_blank" %> driven sale</th>
        <td>
          <strong>Link</strong>: <%= link_to @purchase.utm_link.title, dashboard_utm_links_url(query: @purchase.utm_link.title), target: "_blank" %>
          <br>
          <strong>Source</strong>: <%= @purchase.utm_link.utm_source %>
          <br>
          <strong>Medium</strong>: <%= @purchase.utm_link.utm_medium %>
          <br>
          <strong>Campaign</strong>: <%= @purchase.utm_link.utm_campaign %>
          <% if @purchase.utm_link.utm_term.present? %>
            <br>
            <strong>Term</strong>: <%= @purchase.utm_link.utm_term %>
          <% end %>
          <% if @purchase.utm_link.utm_content.present? %>
            <br>
            <strong>Content</strong>: <%= @purchase.utm_link.utm_content %>
          <% end %>
        </td>
      </tr>
    <% end %>
    <% if @purchase.referrer == "direct" || @referrer_name.present? %>
      <tr>
        <th>Referrer</th>
        <td>
          <% if @purchase.referrer == "direct" %>
            Direct
          <% elsif @purchase.referrer.present? %>
            <a href="<%= @purchase.referrer %>" target="_blank"><%= @referrer_name %></a>
          <% else %>
            <%= @referrer_name %>
          <% end %>
        </td>
      </tr>
    <% end %>
    <% if @buyer_receipt_link.present? %>
      <tr>
        <th>Buyer's receipt</th>
        <td><%= link_to "View receipt", @buyer_receipt_link %></td>
      </tr>
    <% end %>
    <% if @purchase.try(:is_gift_sender_purchase) %>
      <tr>
        <th>Giftee email</th>
        <td><%= @purchase.giftee_email %></td>
      </tr>
    <% end %>
    <% @custom_fields&.each do |field| %>
      <tr>
        <th><%= field[:name] %></th>
        <td><%= field[:value] %></td>
      </tr>
    <% end %>
  </table>
<% end %>

<% if @product.is_physical || @purchase.try(:was_purchase_taxable) %>
  <table class="details">
    <tr>
      <th>Product price</th>
      <td class="nowrap"><%= @purchase.formatted_display_price %></td>
    </tr>
    <% if @purchase.quantity > 1 %>
      <tr>
        <th>Quantity</th>
        <td><%= @purchase.quantity %></td>
      </tr>
    <% end %>
    <% if @product.is_physical %>
      <tr>
        <th>Shipping rate</th>
        <td class="nowrap"><%= @purchase.formatted_shipping_amount %></td>
      </tr>
    <% end %>
    <%= render partial: "notify_table_discount_upsell_rows" %>
    <% if @purchase.seller_tax_amount > 0 %>
      <tr>
        <th><%= @purchase.seller_tax_label %></th>
        <td class="nowrap"><%= @purchase.formatted_seller_tax_amount %></td>
      </tr>
    <% end %>
    <tr class="total">
      <th>Order total</th>
      <td class="nowrap"><%= @purchase.formatted_total_price %></td>
    </tr>
  </table>
<% end %>

<% if @purchase.nil? || @purchase.is_test_purchase? %>
  <div class="callout">
    <p>Because this was a test sale, this amount will not be added to your account balance.</p>
  </div>
<% end %>
