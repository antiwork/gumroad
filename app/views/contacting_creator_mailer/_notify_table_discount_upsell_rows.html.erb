<% display_offer_code = @display_offer_code || @offer_code %>
<% if @offer_code&.code.present? %>
  <tr>
    <th>Discount</th>
    <td><%= @offer_code.name %> <span class="nowrap">(<%= display_offer_code.displayed_amount_off(@product.price_currency_type, with_symbol: true) %> off)</span></td>
  </tr>
<% end %>
<% if @offer_code&.upsell.present? %>
  <tr>
    <th>Upsell</th>
    <td><%= @offer_code.upsell.name %> <span class="nowrap">(<%= display_offer_code.displayed_amount_off(@product.price_currency_type, with_symbol: true) %> off)</span></td>
  </tr>
<% elsif @purchase.upsell_purchase.present? %>
  <tr>
    <th>Upsell</th>
    <td><%= @purchase.upsell_purchase.upsell.name %></td>
  </tr>
<% end %>
