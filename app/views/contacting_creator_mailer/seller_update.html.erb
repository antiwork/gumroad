<%= header_section("Your last week.") %>
<% period = "#{@start_of_period.strftime("%Y-%m-%d")}_#{@end_of_period.strftime("%Y-%m-%d")}" %>
<div>
  <table class="stats" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td>
        <div class="stat">
          <div class="stat-value"><%= @seller.last_weeks_followers %></div>
          <div class="stat-label">New followers</div>
        </div>
      </td>
      <td>
        <div class="stat">
          <div class="stat-value"><%= formatted_dollar_amount(@seller.last_weeks_sales) %></div>
          <div class="stat-label">You made</div>
        </div>
      </td>
    </tr>
  </table>
  <p class="actions">
    <a class="button" href="<%= audience_dashboard_url %>#<%= period %>">View audience</a>
    <a class="button primary" href="<%= sales_dashboard_url %>#<%= period %>">View sales</a>
  </p>
</div>
<% products = @seller.links.alive.has_paid_sales_between(@start_of_period, @end_of_period).to_a %>
<% if products.present? %>
  <%# One column: a product's name with its sales beneath, so neither is squeezed on a phone. %>
  <table class="details">
    <% products.each do |product| %>
      <% sales         = product.sales.paid.not_chargedback_or_chargedback_reversed.where("created_at > ? and created_at <= ?", @start_of_period, @end_of_period) %>
      <% new_subs      = product.sales.paid.not_chargedback_or_chargedback_reversed.not_recurring_charge.where("created_at > ? and created_at <= ?", @start_of_period, @end_of_period) %>
      <% existing_subs = product.sales.paid.not_chargedback_or_chargedback_reversed.recurring_charge.where("created_at > ? and created_at <= ?", @start_of_period, @end_of_period) %>
      <tr>
        <td class="wide" colspan="2">
          <a href="<%= edit_link_url(product) %>"><%= truncate(product.name, separator: " ", length: 48) %></a>
          <br>
          <span class="small muted">
            <% if product.is_recurring_billing %>
              <% if new_subs.count > 0 %>
                <%= pluralize(new_subs.count, "new subscription") %>
                →
                <%= Money.new(new_subs.sum(:price_cents), "USD").format.gsub(".00", "") %>
                <br>
              <% end %>
              <% if existing_subs.count > 0 %>
                <%= pluralize(existing_subs.count, "existing subscription") %>
                →
                <%= Money.new(existing_subs.sum(:price_cents), "USD").format.gsub(".00", "") %>
              <% end %>
            <% else %>
              <%= pluralize(sales.count, "sale") %>
              →
              <%= Money.new(sales.sum(:price_cents), "USD").format.gsub(".00", "") %>
            <% end %>
          </span>
        </td>
      </tr>
    <% end %>
  </table>
<% end %>
