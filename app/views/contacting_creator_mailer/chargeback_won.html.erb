<%= header_section("A dispute has been won") %>
<div>
  <p>
    We have won a dispute against <%= @disputable.customer_email %>'s purchase of <%= @disputable.multiple_purchases? ? "the following items" : @disputable.purchase_for_dispute_evidence.link.name %> for <%= @disputable.formatted_disputed_amount %> on your behalf.<% if @win_credit %> We have added what we deducted back to your balance.<% elsif @balance_debit == :stripe_connect %> The disputed amount has been released back to your connected Stripe account.<% end %>
  </p>
  <%= render("disputed_products", disputable: @disputable) %>
</div>
