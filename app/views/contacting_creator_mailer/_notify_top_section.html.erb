<div class="hero">
  <%= image_tag image_url("email/gumroad_coins.png"), alt: "Cha-ching!", width: 160, height: 130 %>
  <h1 class="eyebrow"><%= @mail_heading %></h1>
  <p class="figure">
    <% if @purchase.present? %>
      <% commission = @purchase.commission %>
      <% if commission.present? %>
        <% deposit_purchase = commission.deposit_purchase %>
        <%= format_just_price_in_cents(deposit_purchase.displayed_price_cents + commission.completion_display_price_cents, deposit_purchase.displayed_price_currency_type) %>
      <% else %>
        <%= @purchase.formatted_display_price %>
      <% end %>
    <% else %>
      <%= @product.price_formatted %>
    <% end %>
  </p>
  <p><%= @product.name %></p>
  <% if @mail_subheading.present? %>
    <p><%= @mail_subheading %></p>
  <% end %>
  <% unless @is_preorder %>
    <p><%= link_to "View account balance", balance_url, class: "button primary" %></p>
  <% end %>
</div>
