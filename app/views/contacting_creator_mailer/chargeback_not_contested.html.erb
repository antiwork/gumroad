<%= header_section(@subject) %>
<div>
  <p>
    We did not respond to the dispute on <%= @disputable.customer_email %>'s purchase of <%= @disputable.multiple_purchases? ? "the following items" : @disputable.purchase_for_dispute_evidence.link.name %> for <%= @disputable.formatted_disputed_amount %>.
  </p>
  <% if @disputable.multiple_purchases? %>
    <% @disputable.disputed_purchases.each do |purchase| %>
      <p>
        <%= link_to purchase.link.name, purchase.link.long_url %>
      </p>
    <% end %>
  <% end %>
  <p>
    Our payment processor charges a fee to respond to every dispute, and for a dispute this small the fee is more than we would usually recover. Since you did not send any evidence of your own, the dispute will be lost.
  </p>
  <p>
    <% case @balance_debit %>
    <% when :full %>
      The amount stays deducted from your balance.
    <% when :partial %>
      The unrefunded part of that amount stays deducted from your balance.
    <% when :refunded %>
      This sale was already refunded in full, so nothing has been deducted from your balance.
    <% when :stripe_connect %>
      This sale was paid into your connected Stripe account, so nothing has been deducted from your Gumroad balance.
    <% else %>
      Nothing has been deducted from your balance.
    <% end %>
  </p>
</div>
