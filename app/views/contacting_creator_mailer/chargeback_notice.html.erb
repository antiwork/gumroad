<%= header_section(@subject) %>
<div>
  <% if @is_paypal %>
    <p>
      A customer of yours (<%= @disputable.customer_email %>) has disputed their purchase of <%= @disputable.multiple_purchases? ? "the following items" : @disputable.purchase_for_dispute_evidence.link.name %> for <%= @disputable.formatted_disputed_amount %>.
    </p>
    <% if @disputable.multiple_purchases? %>
      <% @disputable.disputed_purchases.each do |purchase| %>
        <p>
          <%= link_to purchase.link.name, purchase.link.long_url %>
        </p>
      <% end %>
    <% end %>
    <p>
      The dispute is handled in your PayPal account, so please respond to it there.<% if Feature.active?(:submit_paypal_dispute_evidence) %> Where PayPal lets us add information to the case, we'll send PayPal our delivery record for this order (when the customer opened the download page and downloaded each file).<% end %> If PayPal asks you for proof of delivery, reply to this email and we'll send you that record to attach.
    </p>
    <p>
      You can go <%= link_to "here", "https://www.paypal.com/us/webapps/mpp/security/resolve-disputes" %> for more information or reach out to PayPal's support team for further assistance.
    </p>
    <p>
      If you win the dispute, you'll be notified by us and the amount will be released back to your PayPal account by PayPal.
    </p>
  <% else %>
    <p>
      A customer of yours (<%= @disputable.customer_email %>) has disputed their purchase of <%= @disputable.multiple_purchases? ? "the following items" : @disputable.purchase_for_dispute_evidence.link.name %> for <%= @disputable.formatted_disputed_amount %>.
      <% case @balance_debit %>
      <% when :full %>
        We have deducted the amount from your balance, and are looking into it for you.
      <% when :partial %>
        We have deducted the unrefunded part of that amount from your balance, and are looking into it for you.
      <% when :refunded %>
        This sale was already refunded in full, so nothing has been deducted from your balance.
      <% when :stripe_connect %>
        This sale was paid into your connected Stripe account, so nothing has been deducted from your Gumroad balance.
      <% else %>
        Nothing has been deducted from your balance.
      <% end %>
    </p>
    <% if @disputable.multiple_purchases? %>
      <% @disputable.disputed_purchases.each do |purchase| %>
        <p>
          <%= link_to purchase.link.name, purchase.link.long_url %>
        </p>
      <% end %>
    <% end %>
    <p>
      Sometimes, a customer will dispute a charge with their bank because they don't recognize "Gumroad" on their credit card transaction. We have contacted the customer about this, and have asked them to contact you (if they have a legitimate issue) or their bank (to cancel the dispute).
    </p>
    <%= @dispute_evidence_content %>
    <% case @balance_debit %>
    <% when :stripe_connect %>
      <p>
        We fight every dispute. This sale was paid into your connected Stripe account, so we submit the evidence there, and if we win the amount is released back to that account.
      </p>
    <% when :refunded %>
      <p>
        We fight every dispute. Because the money already went back to your customer, winning the dispute will not change your balance.
      </p>
    <% else %>
      <p>
        <% if @win_credit == :full %>
          We fight every dispute. If we succeed, you will automatically be re-credited the full amount. This process takes up to 75 days.
        <% elsif @win_credit == :partial %>
          We fight every dispute. If we succeed, you will automatically be re-credited the amount we deducted. This process takes up to 75 days.
        <% else %>
          We fight every dispute.
        <% end %>
      </p>
      <% if @won_notification %>
        <p>
          You'll get another notification once we have won the dispute. If you haven't received that notification, we have not yet won this dispute.
        </p>
      <% end %>
    <% end %>
  <% end %>
</div>
