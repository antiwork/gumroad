<%= header_section(@subject) %>
<div>
  <% if @is_paypal %>
    <p>
      A customer of yours (<%= @disputable.customer_email %>) has disputed their purchase of <%= @disputable.multiple_purchases? ? "the following items" : @disputable.purchase_for_dispute_evidence.link.name %> for <%= @disputable.formatted_disputed_amount %>.
    </p>
    <%= render("disputed_products", disputable: @disputable) %>
    <p>
      The dispute is handled in your PayPal account, so please respond to it there.<% if Feature.active?(:submit_paypal_dispute_evidence) %> Where PayPal lets us add information to the case, we'll send PayPal our delivery record for this order (when the customer opened the download page and downloaded each file).<% end %> If PayPal asks you for proof of delivery, reply to this email and we'll send you that record to attach.
    </p>
    <p>
      You can go <%= link_to "here", "https://www.paypal.com/us/webapps/mpp/security/resolve-disputes" %> for more information or reach out to PayPal's support team for further assistance.
    </p>
    <p>
      If you win the dispute, you'll be notified by us and the amount will be released back to your PayPal account by PayPal.
    </p>
  <% else %>
    <p>
      A customer of yours (<%= @disputable.customer_email %>) has disputed their purchase of <%= @disputable.multiple_purchases? ? "the following items" : @disputable.purchase_for_dispute_evidence.link.name %><%= @disputed_amounts_copy %>
      <% case @balance_debit %>
      <% when :full %>
        We have taken what you earned from this sale back out of your balance, and are looking into it for you.
      <% when :partial %>
        We have taken what you earned from the unrefunded part of this sale back out of your balance, and are looking into it for you.
      <% when :refunded %>
        This sale was already refunded in full, so nothing has been deducted from your balance.
      <% when :stripe_connect %>
        This sale was paid into your connected Stripe account, so nothing has been deducted from your Gumroad balance.
      <% else %>
        Nothing has been deducted from your balance.
      <% end %>
    </p>
    <%= render("disputed_products", disputable: @disputable) %>
    <% if @dispute_reason_copy %>
      <p>
        Reason given for the dispute: <%= @dispute_reason_copy %>.
      </p>
    <% end %>
    <% if @explain_unrecognized_charge %>
      <p>
        Sometimes, a customer will dispute a charge with their bank because they don't recognize "Gumroad" on their credit card transaction. We have contacted the customer about this, and have asked them to contact you (if they have a legitimate issue) or their bank (to cancel the dispute).
      </p>
    <% end %>
    <%= @dispute_evidence_content %>
    <% if @small_dispute_reason_copy %>
      <p>
        <%= @small_dispute_reason_copy %>
      </p>
    <% end %>
    <% if @small_dispute_canceled_copy %>
      <p>
        <%= @small_dispute_canceled_copy %>
      </p>
    <% end %>
    <% fight_copy = "We fight every dispute." unless @small_dispute_reason_copy %>
    <% case @balance_debit %>
    <% when :stripe_connect %>
      <p>
        <% if fight_copy %>
          We fight every dispute and submit the evidence through your connected Stripe account. If we win, the disputed amount is released back to that account.
        <% else %>
          We submit your information through your connected Stripe account, and if we win, the disputed amount is released back to that account.
        <% end %>
      </p>
      <% if @dispute_evidence_content %>
        <p>
          Use the button above to send us your information rather than responding in your Stripe dashboard: our payment processor accepts only one response per dispute.
        </p>
      <% end %>
    <% when :refunded %>
      <p>
        <%= fight_copy %> Because the money already went back to your customer, winning the dispute will not change your balance.
      </p>
    <% else %>
      <% if fight_copy || @win_credit %>
        <p>
          <%= fight_copy %><% if @win_credit %> If we succeed, we will automatically add what we deducted back to your balance. This process takes up to 75 days.<% end %>
        </p>
      <% end %>
      <% if @won_notification %>
        <p>
          You'll get another notification once we have won the dispute. If you haven't received that notification, we have not yet won this dispute.
        </p>
      <% end %>
    <% end %>
  <% end %>
</div>
